{
  "components": [
    {
      "type": "text",
      "text": "## Review request",
      "id": "review_request_0"
    },
    {
      "type": "text",
      "text": "**Student:** {{studentName}} ({{studentId}}, {{studentEmail}})\n\n**Type:** {{requestType}} · **Course:** {{course}} · **Days:** {{days}}\n\n**Due date:** {{dueDate}}\n\n**Reason:** {{reason}}",
      "id": "review_request_1"
    },
    {
      "type": "radio",
      "key": "decision",
      "label": "Decision",
      "values": [
        {
          "label": "Approve",
          "value": "approved"
        },
        {
          "label": "Reject",
          "value": "rejected"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "review_request_2"
    },
    {
      "type": "textarea",
      "key": "comment",
      "label": "Comment for the student",
      "id": "review_request_3"
    }
  ],
  "type": "default",
  "id": "review-request",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}