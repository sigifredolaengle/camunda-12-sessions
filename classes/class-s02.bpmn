<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_class-s02" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="class-s02" name="S02 · Variables, FEEL and forms" isExecutable="true">
    <bpmn:documentation>Guided class of session 2: the student runs it in Tasklist.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Class started">
      <bpmn:extensionElements><zeebe:formDefinition formId="class-s02-start" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Config</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Config" name="Prepare the class">
      <bpmn:extensionElements><zeebe:script expression='={caseId: if caseId = null then "student-request" else caseId, testId: if testId = null then "student-request-test" else testId, engineUrl: if engineUrl = null then "http://localhost:8080" else engineUrl, resultsUrl: if resultsUrl = null then "https://script.google.com/macros/s/AKfycbw_pq8bBmwMYtrJ2wetrkkOOZX0nojMt2kow3qfleQh3NQbiI7NDzXuL4SeVliYpBI/exec" else resultsUrl}' resultVariable="cfg" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Config</bpmn:incoming>
      <bpmn:outgoing>Flow_Config_WorkedExample</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="WorkedExample" name="1 Worked example">
      <bpmn:incoming>Flow_Config_WorkedExample</bpmn:incoming>
      <bpmn:outgoing>Flow_WorkedExample_IntakeForm</bpmn:outgoing>
      <bpmn:startEvent id="WorkedExampleStart">
        <bpmn:outgoing>Flow_WorkedExampleStart_PartA</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="WorkedExampleEnd" name="Step done">
        <bpmn:incoming>Flow_GwPartA_WorkedExampleEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="PartA" name="S02 · 1 Worked example">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-part-a" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_WorkedExampleStart_PartA</bpmn:incoming>
        <bpmn:incoming>Flow_GwPartA_PartA</bpmn:incoming>
        <bpmn:outgoing>Flow_PartA_FbPartA</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbPartA" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (count(a1) = 3 and list contains(a1, "orderId") and list contains(a1, "weightKg") and list contains(a1, "orderValue")) and (a1b = "deliveryMode") and (a2 = "nothing") and (a3 = "nextForm") then "" else "Not yet. " + (if count(a1) = 3 and list contains(a1, "orderId") and list contains(a1, "weightKg") and list contains(a1, "orderValue") then "" else "Question 1: three variables come with the start; the others are created later by forms. ") + (if a1b = "deliveryMode" then "" else "Question 2: look at the form of Decide if normal post or special shipment. ") + (if a2 = "nothing" then "" else "Question 3: what does Operate show for a data object? ") + (if a3 = "nextForm" then "" else "Question 4: a form reads the variables when it opens. ")' resultVariable="fbPartA" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_PartA_FbPartA</bpmn:incoming>
        <bpmn:outgoing>Flow_FbPartA_GwPartA</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwPartA" name="Step passed?" default="Flow_GwPartA_PartA">
        <bpmn:incoming>Flow_FbPartA_GwPartA</bpmn:incoming>
        <bpmn:outgoing>Flow_GwPartA_WorkedExampleEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwPartA_PartA</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_WorkedExampleStart_PartA" sourceRef="WorkedExampleStart" targetRef="PartA" />
      <bpmn:sequenceFlow id="Flow_PartA_FbPartA" sourceRef="PartA" targetRef="FbPartA" />
      <bpmn:sequenceFlow id="Flow_FbPartA_GwPartA" sourceRef="FbPartA" targetRef="GwPartA" />
      <bpmn:sequenceFlow id="Flow_GwPartA_WorkedExampleEnd" name="yes" sourceRef="GwPartA" targetRef="WorkedExampleEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbPartA = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwPartA_PartA" name="not yet" sourceRef="GwPartA" targetRef="PartA" />
    </bpmn:subProcess>
    <bpmn:subProcess id="IntakeForm" name="2 The intake form">
      <bpmn:incoming>Flow_WorkedExample_IntakeForm</bpmn:incoming>
      <bpmn:outgoing>Flow_IntakeForm_RunCase</bpmn:outgoing>
      <bpmn:startEvent id="IntakeFormStart">
        <bpmn:outgoing>Flow_IntakeFormStart_Intake</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="IntakeFormEnd" name="Step done">
        <bpmn:incoming>Flow_GwIntake_IntakeFormEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckLatest" name="Check: the latest version">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId, isLatestVersion: true}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={latestDef: response.body.items[1]}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Intake_CheckLatest</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLatest_GetStartForm</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetStartForm" name="Check: its start form">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + (if latestDef = null then "0" else latestDef.processDefinitionKey) + "/form"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={startForm: {formId: response.body.formId, schema: response.body.schema}}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NO_FORM", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLatest_GetStartForm</bpmn:incoming>
        <bpmn:outgoing>Flow_GetStartForm_ReadForm</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="NoForm" name="No start form" attachedToRef="GetStartForm">
        <bpmn:outgoing>Flow_NoForm_EmptyForm</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_NoForm" errorRef="Error_NO_FORM" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="EmptyForm" name="Note: no start form">
        <bpmn:extensionElements><zeebe:script expression='={formId: "", schema: ""}' resultVariable="startForm" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoForm_EmptyForm</bpmn:incoming>
        <bpmn:outgoing>Flow_EmptyForm_ReadForm</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="ReadForm" name="Read the start form">
        <bpmn:extensionElements><zeebe:script expression='={sch: if startForm.schema = null then "" else startForm.schema, missing: (for k in ["studentName",  "studentId",  "studentEmail",  "requestType",  "course",  "days",  "reason"] return if contains(sch, "\"" + k + "\"") then null else k)[item != null], hidden: contains(sch, "\"hide\"")}' resultVariable="intake" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_EmptyForm_ReadForm</bpmn:incoming>
        <bpmn:incoming>Flow_GetStartForm_ReadForm</bpmn:incoming>
        <bpmn:outgoing>Flow_ReadForm_FbIntake</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Intake" name="S02 · 2 The intake form">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-intake" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_IntakeFormStart_Intake</bpmn:incoming>
        <bpmn:incoming>Flow_GwIntake_Intake</bpmn:incoming>
        <bpmn:outgoing>Flow_Intake_CheckLatest</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbIntake" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (latestDef != null and latestDef.hasStartForm = true) and (not(latestDef.hasStartForm = true) or startForm.formId = "request-intake") and (not(latestDef.hasStartForm = true) or count(intake.missing) = 0) and (not(latestDef.hasStartForm = true) or intake.hidden = true) then "" else "Not yet. " + (if latestDef != null and latestDef.hasStartForm = true then "" else "The latest version of " + cfg.caseId + " has no start form. Link request-intake to the start event (Form: Camunda Form (linked)) and deploy the process again. ") + (if not(latestDef.hasStartForm = true) or startForm.formId = "request-intake" then "" else "The start form must have the form ID request-intake (form properties, not the file name). ") + (if not(latestDef.hasStartForm = true) or count(intake.missing) = 0 then "" else "Fields missing in the start form: " + string join(intake.missing, ", ") + ". Keys are case-sensitive. ") + (if not(latestDef.hasStartForm = true) or intake.hidden = true then "" else "Days of postponement must be hidden unless the type is postponement (Hide if). ")' resultVariable="fbIntake" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ReadForm_FbIntake</bpmn:incoming>
        <bpmn:outgoing>Flow_FbIntake_GwIntake</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwIntake" name="Step passed?" default="Flow_GwIntake_Intake">
        <bpmn:incoming>Flow_FbIntake_GwIntake</bpmn:incoming>
        <bpmn:outgoing>Flow_GwIntake_IntakeFormEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwIntake_Intake</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_IntakeFormStart_Intake" sourceRef="IntakeFormStart" targetRef="Intake" />
      <bpmn:sequenceFlow id="Flow_NoForm_EmptyForm" sourceRef="NoForm" targetRef="EmptyForm" />
      <bpmn:sequenceFlow id="Flow_EmptyForm_ReadForm" sourceRef="EmptyForm" targetRef="ReadForm" />
      <bpmn:sequenceFlow id="Flow_Intake_CheckLatest" sourceRef="Intake" targetRef="CheckLatest" />
      <bpmn:sequenceFlow id="Flow_CheckLatest_GetStartForm" sourceRef="CheckLatest" targetRef="GetStartForm" />
      <bpmn:sequenceFlow id="Flow_GetStartForm_ReadForm" sourceRef="GetStartForm" targetRef="ReadForm" />
      <bpmn:sequenceFlow id="Flow_ReadForm_FbIntake" sourceRef="ReadForm" targetRef="FbIntake" />
      <bpmn:sequenceFlow id="Flow_FbIntake_GwIntake" sourceRef="FbIntake" targetRef="GwIntake" />
      <bpmn:sequenceFlow id="Flow_GwIntake_IntakeFormEnd" name="yes" sourceRef="GwIntake" targetRef="IntakeFormEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbIntake = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwIntake_Intake" name="not yet" sourceRef="GwIntake" targetRef="Intake" />
    </bpmn:subProcess>
    <bpmn:subProcess id="RunCase" name="3 Due date, review form and summary">
      <bpmn:incoming>Flow_IntakeForm_RunCase</bpmn:incoming>
      <bpmn:outgoing>Flow_RunCase_StartWithForm</bpmn:outgoing>
      <bpmn:startEvent id="RunCaseStart">
        <bpmn:outgoing>Flow_RunCaseStart_Run</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="RunCaseEnd" name="Step done">
        <bpmn:incoming>Flow_GwRun_RunCaseEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckLastRun" name="Check: the last completed instance">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-instances/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, state: "COMPLETED"}, sort: [{field: "endDate", order: "desc"}], page: {limit: 1}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={lastRunKey: if count(response.body.items) = 0 then "0" else response.body.items[1].processInstanceKey}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Run_CheckLastRun</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLastRun_CheckRunVars</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckRunVars" name="Check: its variables">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/variables/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processInstanceKey: lastRunKey}, page: {limit: 200}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={run: {u: function(x) if x = null then null else if starts with(x, "\"") then substring(x, 2, string length(x) - 2) else x, it: response.body.items, out: {count: count(it), dueDate: u((it[name = "dueDate"].value)[1]), summary: u((it[name = "summary"].value)[1]), decision: u((it[name = "decision"].value)[1]), studentName: u((it[name = "studentName"].value)[1]), requestType: u((it[name = "requestType"].value)[1])}}.out}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLastRun_CheckRunVars</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckRunVars_FbRun</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Run" name="S02 · 3 Due date, review form and summary">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-run" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_RunCaseStart_Run</bpmn:incoming>
        <bpmn:incoming>Flow_GwRun_Run</bpmn:incoming>
        <bpmn:outgoing>Flow_Run_CheckLastRun</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbRun" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (lastRunKey != "0") and (lastRunKey = "0" or run.dueDate != null and matches(run.dueDate, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) and (lastRunKey = "0" or run.decision != null) and (lastRunKey = "0" or run.summary != null and run.summary = "Request of " + run.studentName + " (" + run.requestType + "): " + run.decision) and (lastRunKey = "0" or replace(trim(cpDueDate), "^\"|\"$", "") = run.dueDate and replace(trim(cpSummary), "^\"|\"$", "") = run.summary) then "" else "Not yet. " + (if lastRunKey != "0" then "" else "The engine has no completed instance of " + cfg.caseId + ". Complete Review request in Tasklist. ") + (if lastRunKey = "0" or run.dueDate != null and matches(run.dueDate, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") then "" else "Your last completed instance has no dueDate like 2026-11-25. Check Compute due date: a FEEL expression with result variable dueDate. ") + (if lastRunKey = "0" or run.decision != null then "" else "Your last completed instance has no decision. Is review-request linked to Review request, and did you choose an option? ") + (if lastRunKey = "0" or run.summary != null and run.summary = "Request of " + run.studentName + " (" + run.requestType + "): " + run.decision then "" else "summary is missing or does not follow the pattern Request of &lt;name&gt; (&lt;type&gt;): &lt;decision&gt;. Check Build summary and its result variable. ") + (if lastRunKey = "0" or replace(trim(cpDueDate), "^\"|\"$", "") = run.dueDate and replace(trim(cpSummary), "^\"|\"$", "") = run.summary then "" else "Checkpoint: copy dueDate and summary exactly as Operate shows them for your last completed instance. ")' resultVariable="fbRun" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckRunVars_FbRun</bpmn:incoming>
        <bpmn:outgoing>Flow_FbRun_GwRun</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwRun" name="Step passed?" default="Flow_GwRun_Run">
        <bpmn:incoming>Flow_FbRun_GwRun</bpmn:incoming>
        <bpmn:outgoing>Flow_GwRun_RunCaseEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwRun_Run</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_RunCaseStart_Run" sourceRef="RunCaseStart" targetRef="Run" />
      <bpmn:sequenceFlow id="Flow_Run_CheckLastRun" sourceRef="Run" targetRef="CheckLastRun" />
      <bpmn:sequenceFlow id="Flow_CheckLastRun_CheckRunVars" sourceRef="CheckLastRun" targetRef="CheckRunVars" />
      <bpmn:sequenceFlow id="Flow_CheckRunVars_FbRun" sourceRef="CheckRunVars" targetRef="FbRun" />
      <bpmn:sequenceFlow id="Flow_FbRun_GwRun" sourceRef="FbRun" targetRef="GwRun" />
      <bpmn:sequenceFlow id="Flow_GwRun_RunCaseEnd" name="yes" sourceRef="GwRun" targetRef="RunCaseEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbRun = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwRun_Run" name="not yet" sourceRef="GwRun" targetRef="Run" />
    </bpmn:subProcess>
    <bpmn:subProcess id="StartWithForm" name="4 Start it with the form">
      <bpmn:incoming>Flow_RunCase_StartWithForm</bpmn:incoming>
      <bpmn:outgoing>Flow_StartWithForm_FeelStep</bpmn:outgoing>
      <bpmn:startEvent id="StartWithFormStart">
        <bpmn:outgoing>Flow_StartWithFormStart_StartForm</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="StartWithFormEnd" name="Step done">
        <bpmn:incoming>Flow_GwStartForm_StartWithFormEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="StartForm" name="S02 · 4 Start it with the form">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-start-form" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_StartWithFormStart_StartForm</bpmn:incoming>
        <bpmn:incoming>Flow_GwStartForm_StartForm</bpmn:incoming>
        <bpmn:outgoing>Flow_StartForm_FbStartForm</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbStartForm" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (daysHidden = "hidden") then "" else "Not yet. " + (if daysHidden = "hidden" then "" else "Choose Certificate in the form and look at the fields again. ")' resultVariable="fbStartForm" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_StartForm_FbStartForm</bpmn:incoming>
        <bpmn:outgoing>Flow_FbStartForm_GwStartForm</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwStartForm" name="Step passed?" default="Flow_GwStartForm_StartForm">
        <bpmn:incoming>Flow_FbStartForm_GwStartForm</bpmn:incoming>
        <bpmn:outgoing>Flow_GwStartForm_StartWithFormEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwStartForm_StartForm</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_StartWithFormStart_StartForm" sourceRef="StartWithFormStart" targetRef="StartForm" />
      <bpmn:sequenceFlow id="Flow_StartForm_FbStartForm" sourceRef="StartForm" targetRef="FbStartForm" />
      <bpmn:sequenceFlow id="Flow_FbStartForm_GwStartForm" sourceRef="FbStartForm" targetRef="GwStartForm" />
      <bpmn:sequenceFlow id="Flow_GwStartForm_StartWithFormEnd" name="yes" sourceRef="GwStartForm" targetRef="StartWithFormEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbStartForm = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwStartForm_StartForm" name="not yet" sourceRef="GwStartForm" targetRef="StartForm" />
    </bpmn:subProcess>
    <bpmn:subProcess id="FeelStep" name="5 FEEL">
      <bpmn:incoming>Flow_StartWithForm_FeelStep</bpmn:incoming>
      <bpmn:outgoing>Flow_FeelStep_Review</bpmn:outgoing>
      <bpmn:startEvent id="FeelStepStart">
        <bpmn:outgoing>Flow_FeelStepStart_Feel</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="FeelStepEnd" name="Step done">
        <bpmn:incoming>Flow_GwFeel_FeelStepEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="EvalFeel" name="Check: evaluate your expression">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/expression/evaluation"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={t: trim(feelUrgent), x: if starts with(t, "=") then substring(t, 2) else t, body: {expression: "=for d in [2, 3, 10] return {days: d, r: (" + x + ")}.r"}}.body' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={feelResult: response.body.result}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("FEEL_INVALID", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Feel_EvalFeel</bpmn:incoming>
        <bpmn:outgoing>Flow_EvalFeel_FbFeel</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="FeelInvalid" name="Not valid FEEL" attachedToRef="EvalFeel">
        <bpmn:outgoing>Flow_FeelInvalid_NoFeel</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_FeelInvalid" errorRef="Error_FEEL_INVALID" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="NoFeel" name="Note: not valid FEEL">
        <bpmn:extensionElements><zeebe:script expression='="invalid"' resultVariable="feelResult" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_FeelInvalid_NoFeel</bpmn:incoming>
        <bpmn:outgoing>Flow_NoFeel_FbFeel</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Feel" name="S02 · 5 FEEL">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-feel" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_FeelStepStart_Feel</bpmn:incoming>
        <bpmn:incoming>Flow_GwFeel_Feel</bpmn:incoming>
        <bpmn:outgoing>Flow_Feel_EvalFeel</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbFeel" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (feelCompare = "single") and (feelJoin = "plus") and (formIdQ = "id") and (not(feelResult instance of string)) and (feelResult instance of string or feelResult = ["urgent", "normal", "normal"]) then "" else "Not yet. " + (if feelCompare = "single" then "" else "Question 1: FEEL has no double equals. ") + (if feelJoin = "plus" then "" else "Question 2: see Build summary. ") + (if formIdQ = "id" then "" else "Question 3: what did you type in Review request to link review-request-s02.form? ") + (if not(feelResult instance of string) then "" else "Question 4: the engine could not read your expression. Check the quotes and the words if, then, else. ") + (if feelResult instance of string or feelResult = ["urgent", "normal", "normal"] then "" else "Question 4: with days 2 the result must be urgent; with days 3 and 10, normal. ")' resultVariable="fbFeel" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoFeel_FbFeel</bpmn:incoming>
        <bpmn:incoming>Flow_EvalFeel_FbFeel</bpmn:incoming>
        <bpmn:outgoing>Flow_FbFeel_GwFeel</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwFeel" name="Step passed?" default="Flow_GwFeel_Feel">
        <bpmn:incoming>Flow_FbFeel_GwFeel</bpmn:incoming>
        <bpmn:outgoing>Flow_GwFeel_FeelStepEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwFeel_Feel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_FeelStepStart_Feel" sourceRef="FeelStepStart" targetRef="Feel" />
      <bpmn:sequenceFlow id="Flow_FeelInvalid_NoFeel" sourceRef="FeelInvalid" targetRef="NoFeel" />
      <bpmn:sequenceFlow id="Flow_NoFeel_FbFeel" sourceRef="NoFeel" targetRef="FbFeel" />
      <bpmn:sequenceFlow id="Flow_Feel_EvalFeel" sourceRef="Feel" targetRef="EvalFeel" />
      <bpmn:sequenceFlow id="Flow_EvalFeel_FbFeel" sourceRef="EvalFeel" targetRef="FbFeel" />
      <bpmn:sequenceFlow id="Flow_FbFeel_GwFeel" sourceRef="FbFeel" targetRef="GwFeel" />
      <bpmn:sequenceFlow id="Flow_GwFeel_FeelStepEnd" name="yes" sourceRef="GwFeel" targetRef="FeelStepEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbFeel = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwFeel_Feel" name="not yet" sourceRef="GwFeel" targetRef="Feel" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Review" name="6–7 Self-check and compare">
      <bpmn:incoming>Flow_FeelStep_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_SendResults</bpmn:outgoing>
      <bpmn:startEvent id="ReviewStart">
        <bpmn:outgoing>Flow_ReviewStart_SelfCheck</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="ReviewEnd" name="Step done">
        <bpmn:incoming>Flow_Compare_ReviewEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="SelfCheck" name="S02 · 6 Self-check">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-self-check" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ReviewStart_SelfCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_SelfCheck_Compare</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Compare" name="S02 · 7 Compare with the model answers">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-compare" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SelfCheck_Compare</bpmn:incoming>
        <bpmn:outgoing>Flow_Compare_ReviewEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_ReviewStart_SelfCheck" sourceRef="ReviewStart" targetRef="SelfCheck" />
      <bpmn:sequenceFlow id="Flow_SelfCheck_Compare" sourceRef="SelfCheck" targetRef="Compare" />
      <bpmn:sequenceFlow id="Flow_Compare_ReviewEnd" sourceRef="Compare" targetRef="ReviewEnd" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SendResults" name="Send the results">
      <bpmn:incoming>Flow_Review_SendResults</bpmn:incoming>
      <bpmn:outgoing>Flow_SendResults_End</bpmn:outgoing>
      <bpmn:startEvent id="SendResultsStart">
        <bpmn:outgoing>Flow_SendResultsStart_GwSend</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SendResultsEnd" name="Step done">
        <bpmn:incoming>Flow_GwSend_SendResultsEnd</bpmn:incoming>
        <bpmn:incoming>Flow_Send_SendResultsEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GwSend" name="Results sheet set?" default="Flow_GwSend_SendResultsEnd">
        <bpmn:incoming>Flow_SendResultsStart_GwSend</bpmn:incoming>
        <bpmn:outgoing>Flow_GwSend_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwSend_SendResultsEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Send" name="Send the results to the teacher">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source="=cfg.resultsUrl" target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={token: "p2a-camunda-2026", session: "s02", finishedAt: string(now()), rut: rut, lastName: lastName, firstName: firstName, studentEmail: studentEmail, a1: string join(a1, "+"), a1b: a1b, a2: a2, a3: a3, cpDueDate: cpDueDate, cpSummary: cpSummary, daysHidden: daysHidden, feelCompare: feelCompare, feelJoin: feelJoin, formIdQ: formIdQ, feelUrgent: feelUrgent, self1: self1, self2: self2, rateSelf1: rateSelf1, rateSelf2: rateSelf2}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="errorExpression" value='=if error != null then bpmnError("SEND_FAILED", error.message) else null' /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_GwSend_Send</bpmn:incoming>
        <bpmn:outgoing>Flow_Send_SendResultsEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SendFailed" name="Not sent" attachedToRef="Send">
        <bpmn:outgoing>Flow_SendFailed_TellTeacher</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_SendFailed" errorRef="Error_SEND_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="TellTeacher" name="S02 · Results not sent: tell the teacher">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s02-not-sent" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SendFailed_TellTeacher</bpmn:incoming>
        <bpmn:outgoing>Flow_TellTeacher_SendResultsNotSent</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SendResultsNotSent" name="Teacher told">
        <bpmn:incoming>Flow_TellTeacher_SendResultsNotSent</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SendResultsStart_GwSend" sourceRef="SendResultsStart" targetRef="GwSend" />
      <bpmn:sequenceFlow id="Flow_SendFailed_TellTeacher" sourceRef="SendFailed" targetRef="TellTeacher" />
      <bpmn:sequenceFlow id="Flow_GwSend_Send" name="yes" sourceRef="GwSend" targetRef="Send">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cfg.resultsUrl != ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwSend_SendResultsEnd" name="no" sourceRef="GwSend" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_Send_SendResultsEnd" sourceRef="Send" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_TellTeacher_SendResultsNotSent" sourceRef="TellTeacher" targetRef="SendResultsNotSent" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End" name="Class completed">
      <bpmn:incoming>Flow_SendResults_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Config" sourceRef="Start" targetRef="Config" />
    <bpmn:sequenceFlow id="Flow_Config_WorkedExample" sourceRef="Config" targetRef="WorkedExample" />
    <bpmn:sequenceFlow id="Flow_WorkedExample_IntakeForm" sourceRef="WorkedExample" targetRef="IntakeForm" />
    <bpmn:sequenceFlow id="Flow_IntakeForm_RunCase" sourceRef="IntakeForm" targetRef="RunCase" />
    <bpmn:sequenceFlow id="Flow_RunCase_StartWithForm" sourceRef="RunCase" targetRef="StartWithForm" />
    <bpmn:sequenceFlow id="Flow_StartWithForm_FeelStep" sourceRef="StartWithForm" targetRef="FeelStep" />
    <bpmn:sequenceFlow id="Flow_FeelStep_Review" sourceRef="FeelStep" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_SendResults" sourceRef="Review" targetRef="SendResults" />
    <bpmn:sequenceFlow id="Flow_SendResults_End" sourceRef="SendResults" targetRef="End" />
  </bpmn:process>
  <bpmn:error id="Error_NO_FORM" name="No start form" errorCode="NO_FORM" />
  <bpmn:error id="Error_FEEL_INVALID" name="Not valid FEEL" errorCode="FEEL_INVALID" />
  <bpmn:error id="Error_SEND_FAILED" name="Results not sent" errorCode="SEND_FAILED" />
