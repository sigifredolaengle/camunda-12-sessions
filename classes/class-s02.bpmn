      <bpmndi:BPMNShape id="RunCaseStart_di" bpmnElement="RunCaseStart"><dc:Bounds x="127" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Run_di" bpmnElement="Run"><dc:Bounds x="260" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckLastRun_di" bpmnElement="CheckLastRun"><dc:Bounds x="430" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckRunVars_di" bpmnElement="CheckRunVars"><dc:Bounds x="600" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FbRun_di" bpmnElement="FbRun"><dc:Bounds x="770" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwRun_di" bpmnElement="GwRun" isMarkerVisible="true"><dc:Bounds x="970" y="120" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RunCaseEnd_di" bpmnElement="RunCaseEnd"><dc:Bounds x="1147" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_RunCaseStart_Run_di" bpmnElement="Flow_RunCaseStart_Run"><di:waypoint x="163" y="145" /><di:waypoint x="260" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Run_CheckLastRun_di" bpmnElement="Flow_Run_CheckLastRun"><di:waypoint x="370" y="145" /><di:waypoint x="430" y="145" /></bpmndi:BPMNEdge>
