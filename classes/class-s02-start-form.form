{
  "components": [
    {
      "type": "text",
      "text": "## Step 4: start it with the form\nIn Tasklist, open the *Processes* tab (*Procesos*), find *Student request* and start it: the intake form opens. Fill it in, but before you submit, choose each type of request and watch the fields.",
      "id": "class_s02_start_form_0"
    },
    {
      "type": "text",
      "text": "**Feedback.** {{fbStartForm}}",
      "conditional": {
        "hide": "=fbStartForm = null or fbStartForm = \"\""
      },
      "id": "class_s02_start_form_1"
    },
    {
      "type": "radio",
      "key": "daysHidden",
      "label": "With the type Certificate, the field Days of postponement is...",
      "values": [
        {
          "label": "hidden",
          "value": "hidden"
        },
        {
          "label": "shown, but optional",
          "value": "shown"
        },
        {
          "label": "shown and required",
          "value": "required"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "class_s02_start_form_2"
    }
  ],
  "type": "default",
  "id": "class-s02-start-form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
