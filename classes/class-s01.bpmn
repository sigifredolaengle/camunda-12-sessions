    <bpmn:sequenceFlow id="Flow_Review_SendResults" sourceRef="Review" targetRef="SendResults" />
    <bpmn:sequenceFlow id="Flow_SendResults_End" sourceRef="SendResults" targetRef="End" />
  </bpmn:process>
