{
  "components": [
    {
      "type": "text",
      "text": "## Delivery pending\n{{deliveryError}}\nYour check has not been confirmed as received. Retry after restoring internet, correct your RUT, recheck your work, or tell the teacher and keep this instance key.",
      "id": "class_s01_not_sent_0"
    },
    {
      "type": "textfield",
      "key": "rut",
      "label": "RUT",
      "validate": {
        "required": true,
        "validationType": "custom",
        "pattern": "^[0-9]{1,2}\\.?[0-9]{3}\\.?[0-9]{3}-?[0-9kK]$"
      },
      "id": "class_s01_not_sent_1"
    },
    {
      "type": "radio",
      "key": "deliveryAction",
      "label": "What next?",
      "values": [
        {
          "label": "Retry the same submission",
          "value": "retry"
        },
        {
          "label": "Check my work again",
          "value": "recheck"
        },
        {
          "label": "I told the teacher; keep delivery pending",
          "value": "teacher"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "class_s01_not_sent_2"
    }
  ],
  "type": "default",
  "id": "class-s01-not-sent",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}
