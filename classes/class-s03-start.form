{
  "components": [
    {
      "type": "text",
      "text": "## S03 · End-of-session check\nFollow the guide first. You may complete this lab independently after class. The School administration determines the exam date. All labs close at 23:59 America/Santiago on that day; later submissions remain accepted and are marked Late. Until that date is configured, the receipt says Deadline not configured.\n\nYour result goes to the teacher at the end: write your RUT with care.",
      "id": "class_s03_start_0"
    },
    {
      "type": "textfield",
      "key": "rut",
      "label": "RUT",
      "validate": {
        "required": true,
        "validationType": "custom",
        "pattern": "^[0-9]{1,2}\\.?[0-9]{3}\\.?[0-9]{3}-?[0-9kK]$"
      },
      "description": "Format 12.345.678-5",
      "id": "class_s03_start_1"
    },
    {
      "type": "textfield",
      "key": "lastName",
      "label": "Last name(s)",
      "validate": {
        "required": true
      },
      "id": "class_s03_start_2"
    },
    {
      "type": "textfield",
      "key": "firstName",
      "label": "First name(s)",
      "validate": {
        "required": true
      },
      "id": "class_s03_start_3"
    },
    {
      "type": "textfield",
      "key": "studentEmail",
      "label": "E-mail",
      "validate": {
        "required": true,
        "validationType": "email"
      },
      "id": "class_s03_start_4"
    }
  ],
  "type": "default",
  "id": "class-s03-start",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}
