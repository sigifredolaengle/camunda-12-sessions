{
  "components": [
    {
      "type": "text",
      "text": "## S03 · End-of-session check\nStart this check when you have finished steps 3 to 6 of the guide. The engine reads your latest *student-request*, your three instances and the incident of step 6.\n\n- If something is missing, the task comes back with **Feedback**: fix it and complete the task again.\n- When everything is there, your result goes to the teacher.\n\nFill in your data to start.\n\nYour answers go to the teacher at the end.",
      "id": "class_s03_start_0"
    },
    {
      "type": "textfield",
      "key": "rut",
      "label": "RUT",
      "validate": {
        "required": true
      },
      "description": "Format 12.345.678-5",
      "id": "class_s03_start_1"
    },
    {
      "type": "textfield",
      "key": "lastName",
      "label": "Last name(s)",
      "validate": {
        "required": true
      },
      "id": "class_s03_start_2"
    },
    {
      "type": "textfield",
      "key": "firstName",
      "label": "First name(s)",
      "validate": {
        "required": true
      },
      "id": "class_s03_start_3"
    },
    {
      "type": "textfield",
      "key": "studentEmail",
      "label": "E-mail",
      "validate": {
        "required": true,
        "validationType": "email"
      },
      "id": "class_s03_start_4"
    }
  ],
  "type": "default",
  "id": "class-s03-start",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}
