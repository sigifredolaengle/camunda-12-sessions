{
  "components": [
    {
      "type": "text",
      "text": "## S03 · Check your work\n*Guide: steps 3 to 6.*",
      "id": "class_s03_check_0"
    },
    {
      "type": "text",
      "text": "### ⚠ Feedback from the engine\n{{fbCheck}}",
      "conditional": {
        "hide": "=fbCheck = null or fbCheck = \"\""
      },
      "id": "class_s03_check_1"
    },
    {
      "type": "text",
      "text": "### Done when\nSelect the repaired session-3 version; complete certificate, postponement approved, recognition rejected, and recognition approved. Keep the resolved condition incident at `Approved?`; leave no active incident.",
      "id": "class_s03_check_2"
    },
    {
      "type": "textfield",
      "key": "assessedVersion",
      "label": "Version to assess (optional)",
      "description": "Operate → process version number, for example 2. Leave blank only if the latest version belongs to this session.",
      "id": "class_s03_check_3"
    },
    {
      "type": "text",
      "text": "Complete this task to check. Wait a few seconds after deploying. If earlier evidence has been deleted, replay the instances from the guide. A passed local check is not a delivery receipt.",
      "id": "class_s03_check_4"
    }
  ],
  "type": "default",
  "id": "class-s03-check",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}
