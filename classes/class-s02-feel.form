{
  "components": [
    {
      "type": "text",
      "text": "## Step 5: FEEL\nThe engine evaluates your answer to question 4 with days = 2, 3 and 10.",
      "id": "class_s02_feel_0"
    },
    {
      "type": "text",
      "text": "**Feedback.** {{fbFeel}}",
      "conditional": {
        "hide": "=fbFeel = null or fbFeel = \"\""
      },
      "id": "class_s02_feel_1"
    },
    {
      "type": "radio",
      "key": "feelCompare",
      "label": "1. In FEEL, how do you compare two values?",
      "values": [
        {
          "label": "a = b",
          "value": "single"
        },
        {
          "label": "a == b",
          "value": "double"
        },
        {
          "label": "a.equals(b)",
          "value": "equals"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "class_s02_feel_2"
    },
    {
      "type": "radio",
      "key": "feelJoin",
      "label": "2. How do you join two strings?",
      "values": [
        {
          "label": "\"a\" + \"b\"",
          "value": "plus"
        },
        {
          "label": "\"a\" & \"b\"",
          "value": "amp"
        },
        {
          "label": "Only with concat(\"a\", \"b\")",
          "value": "concat"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "class_s02_feel_3"
    },
    {
      "type": "radio",
      "key": "formIdQ",
      "label": "3. A user task links a form by...",
      "values": [
        {
          "label": "its form ID, set in the form's properties",
          "value": "id"
        },
        {
          "label": "its file name, for example review-request-s02.form",
          "value": "file"
        },
        {
          "label": "both, and they must be equal",
          "value": "both"
        }
      ],
      "validate": {
        "required": true
      },
      "id": "class_s02_feel_4"
    },
    {
      "type": "textfield",
      "key": "feelUrgent",
      "label": "4. Write a FEEL expression that gives \"urgent\" when days is less than 3, and \"normal\" otherwise.",
      "validate": {
        "required": true
      },
      "id": "class_s02_feel_5"
    }
  ],
  "type": "default",
  "id": "class-s02-feel",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "schemaVersion": 18
}
