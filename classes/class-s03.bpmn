<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_class-s03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="class-s03" name="S03 · Gateways" isExecutable="true">
    <bpmn:documentation>Guided class of session 3: the student runs it in Tasklist.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Class started">
      <bpmn:extensionElements><zeebe:formDefinition formId="class-s03-start" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Config</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Config" name="Prepare the class">
      <bpmn:extensionElements><zeebe:script expression='={caseId: if caseId = null then "student-request" else caseId, testId: if testId = null then "student-request-test" else testId, engineUrl: if engineUrl = null then "http://localhost:8080" else engineUrl, resultsUrl: if resultsUrl = null then "https://script.google.com/macros/s/AKfycbw_pq8bBmwMYtrJ2wetrkkOOZX0nojMt2kow3qfleQh3NQbiI7NDzXuL4SeVliYpBI/exec" else resultsUrl}' resultVariable="cfg" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Config</bpmn:incoming>
      <bpmn:outgoing>Flow_Config_WorkedExample</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="WorkedExample" name="1 Worked example">
      <bpmn:incoming>Flow_Config_WorkedExample</bpmn:incoming>
      <bpmn:outgoing>Flow_WorkedExample_SafeConditions</bpmn:outgoing>
      <bpmn:startEvent id="WorkedExampleStart">
        <bpmn:outgoing>Flow_WorkedExampleStart_PartA</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="WorkedExampleEnd" name="Step done">
        <bpmn:incoming>Flow_GwPartA_WorkedExampleEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="PartA" name="S03 · 1 Worked example">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-part-a" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_WorkedExampleStart_PartA</bpmn:incoming>
        <bpmn:incoming>Flow_GwPartA_PartA</bpmn:incoming>
        <bpmn:outgoing>Flow_PartA_FbPartA</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbPartA" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (a1 = "two") and (count(a2) = 2 and list contains(a2, "label") and list contains(a2, "insurance")) and (a2b = "started") and (a3 = "onlyOne") then "" else "Not yet. " + (if a1 = "two" then "" else "Question 1: a parallel split sends a token down every branch. ") + (if count(a2) = 2 and list contains(a2, "label") and list contains(a2, "insurance") then "" else "Question 2: which two tasks follow the gateway after Check if extra insurance is necessary? ") + (if a2b = "started" then "" else "Question 3: watch the token simulation after one of the two tasks finishes. ") + (if a3 = "onlyOne" then "" else "Question 4: how many of the two delivery modes run in one instance? ")' resultVariable="fbPartA" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_PartA_FbPartA</bpmn:incoming>
        <bpmn:outgoing>Flow_FbPartA_GwPartA</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwPartA" name="Step passed?" default="Flow_GwPartA_PartA">
        <bpmn:incoming>Flow_FbPartA_GwPartA</bpmn:incoming>
        <bpmn:outgoing>Flow_GwPartA_WorkedExampleEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwPartA_PartA</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_WorkedExampleStart_PartA" sourceRef="WorkedExampleStart" targetRef="PartA" />
      <bpmn:sequenceFlow id="Flow_PartA_FbPartA" sourceRef="PartA" targetRef="FbPartA" />
      <bpmn:sequenceFlow id="Flow_FbPartA_GwPartA" sourceRef="FbPartA" targetRef="GwPartA" />
      <bpmn:sequenceFlow id="Flow_GwPartA_WorkedExampleEnd" name="yes" sourceRef="GwPartA" targetRef="WorkedExampleEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbPartA = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwPartA_PartA" name="not yet" sourceRef="GwPartA" targetRef="PartA" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SafeConditions" name="2 On the engine, safe conditions">
      <bpmn:incoming>Flow_WorkedExample_SafeConditions</bpmn:incoming>
      <bpmn:outgoing>Flow_SafeConditions_RouteDecide</bpmn:outgoing>
      <bpmn:startEvent id="SafeConditionsStart">
        <bpmn:outgoing>Flow_SafeConditionsStart_Safe</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SafeConditionsEnd" name="Step done">
        <bpmn:incoming>Flow_GwSafe_SafeConditionsEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="EvalSafe" name="Check: evaluate your condition">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/expression/evaluation"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={t: trim(feelSafe), x: if starts with(t, "=") then substring(t, 2) else t, body: {expression: "=for d in [null, 5, 20] return {days: d, r: (" + x + ")}.r"}}.body' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={safeResult: response.body.result}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("FEEL_INVALID", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Safe_EvalSafe</bpmn:incoming>
        <bpmn:outgoing>Flow_EvalSafe_FbSafe</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SafeInvalid" name="Not valid FEEL" attachedToRef="EvalSafe">
        <bpmn:outgoing>Flow_SafeInvalid_NoSafe</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_SafeInvalid" errorRef="Error_FEEL_INVALID" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="NoSafe" name="Note: not valid FEEL">
        <bpmn:extensionElements><zeebe:script expression='="invalid"' resultVariable="safeResult" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SafeInvalid_NoSafe</bpmn:incoming>
        <bpmn:outgoing>Flow_NoSafe_FbSafe</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Safe" name="S03 · 2 On the engine, safe conditions">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-safe" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SafeConditionsStart_Safe</bpmn:incoming>
        <bpmn:incoming>Flow_GwSafe_Safe</bpmn:incoming>
        <bpmn:outgoing>Flow_Safe_EvalSafe</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbSafe" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (ex1 = "form") and (ex2 = "default") and (ex3 = "label") and (sc1 = "default") and (sc2 = "incident") and (sc3 = "flow") and (not(safeResult instance of string)) and (safeResult instance of string or safeResult = [false, false, true]) then "" else "Not yet. " + (if ex1 = "form" then "" else "Question 1: open the form of Decide if normal post or special shipment: what is the key of its field? ") + (if ex2 = "default" then "" else "Question 2: look at the start of the arrow normal post: it has a small slash. ") + (if ex3 = "label" then "" else "Question 3: an unticked checkbox gives false, and false = true is false. ") + (if sc1 = "default" then "" else "Question 4: an equality with a missing value is false, not an error. ") + (if sc2 = "incident" then "" else "Question 5: what is null greater than 2? ") + (if sc3 = "flow" then "" else "Question 6: select the arrow, not the diamond. ") + (if not(safeResult instance of string) then "" else "Question 7: the engine could not read your condition. Check the words and, or, if, then, else. ") + (if safeResult instance of string or safeResult = [false, false, true] then "" else "Question 7: with days missing and with 5 the result must be false; with 20, true. A comparison with a missing days gives null. ")' resultVariable="fbSafe" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoSafe_FbSafe</bpmn:incoming>
        <bpmn:incoming>Flow_EvalSafe_FbSafe</bpmn:incoming>
        <bpmn:outgoing>Flow_FbSafe_GwSafe</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwSafe" name="Step passed?" default="Flow_GwSafe_Safe">
        <bpmn:incoming>Flow_FbSafe_GwSafe</bpmn:incoming>
        <bpmn:outgoing>Flow_GwSafe_SafeConditionsEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwSafe_Safe</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_SafeConditionsStart_Safe" sourceRef="SafeConditionsStart" targetRef="Safe" />
      <bpmn:sequenceFlow id="Flow_SafeInvalid_NoSafe" sourceRef="SafeInvalid" targetRef="NoSafe" />
      <bpmn:sequenceFlow id="Flow_NoSafe_FbSafe" sourceRef="NoSafe" targetRef="FbSafe" />
      <bpmn:sequenceFlow id="Flow_Safe_EvalSafe" sourceRef="Safe" targetRef="EvalSafe" />
      <bpmn:sequenceFlow id="Flow_EvalSafe_FbSafe" sourceRef="EvalSafe" targetRef="FbSafe" />
      <bpmn:sequenceFlow id="Flow_FbSafe_GwSafe" sourceRef="FbSafe" targetRef="GwSafe" />
      <bpmn:sequenceFlow id="Flow_GwSafe_SafeConditionsEnd" name="yes" sourceRef="GwSafe" targetRef="SafeConditionsEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbSafe = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwSafe_Safe" name="not yet" sourceRef="GwSafe" targetRef="Safe" />
    </bpmn:subProcess>
    <bpmn:subProcess id="RouteDecide" name="3 Route by type and decide">
      <bpmn:incoming>Flow_SafeConditions_RouteDecide</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteDecide_Notify</bpmn:outgoing>
      <bpmn:startEvent id="RouteDecideStart">
        <bpmn:outgoing>Flow_RouteDecideStart_Route</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="RouteDecideEnd" name="Step done">
        <bpmn:incoming>Flow_GwRoute_RouteDecideEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckLatest3" name="Check: the latest version">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId, isLatestVersion: true}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={latestDef: response.body.items[1]}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Route_CheckLatest3</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLatest3_GetXml3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetXml3" name="Check: read its model">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + (if latestDef = null then "0" else latestDef.processDefinitionKey) + "/xml"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={model: {x: if response.body = null then "" else string(response.body), n: function(s, p) count(split(s, p)) - 1, out: {xorCount: n(x, "&lt;(bpmn:)?exclusiveGateway[ &gt;/]"), xorDefaults: n(x, "&lt;(bpmn:)?exclusiveGateway[^&gt;]*default="), orCount: n(x, "&lt;(bpmn:)?inclusiveGateway[ &gt;/]"), andCount: n(x, "&lt;(bpmn:)?parallelGateway[ &gt;/]"), missing: (for k in ["certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"] return if contains(x, "resultVariable=\"" + k + "\"") then null else k)[item != null]}}.out}' /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NO_MODEL", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLatest3_GetXml3</bpmn:incoming>
        <bpmn:outgoing>Flow_GetXml3_FbRoute</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="NoXml3" name="No model" attachedToRef="GetXml3">
        <bpmn:outgoing>Flow_NoXml3_EmptyXml3</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_NoXml3" errorRef="Error_NO_MODEL" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="EmptyXml3" name="Note: no model">
        <bpmn:extensionElements><zeebe:script expression="=null" resultVariable="model" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoXml3_EmptyXml3</bpmn:incoming>
        <bpmn:outgoing>Flow_EmptyXml3_FbRoute</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Route" name="S03 · 3 Route by type and decide">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-route" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_RouteDecideStart_Route</bpmn:incoming>
        <bpmn:incoming>Flow_GwRoute_Route</bpmn:incoming>
        <bpmn:outgoing>Flow_Route_CheckLatest3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbRoute" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (model != null) and (model = null or model.xorCount &gt;= 3) and (model = null or model.xorDefaults &gt;= 2) and (model = null or count(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"]) = 0) then "" else "Not yet. " + (if model != null then "" else "The engine has no deployed version of " + cfg.caseId + ". Deploy your thread-s03.bpmn (rocket icon) and wait a few seconds. ") + (if model = null or model.xorCount &gt;= 3 then "" else "Your latest version has " + string(model.xorCount) + " exclusive gateways; it needs three: Type of request?, Approved? and the merge. Did you deploy after saving? After a deploy, wait a few seconds. ") + (if model = null or model.xorDefaults &gt;= 2 then "" else "Type of request? and Approved? each need a default flow: select the arrow, wrench icon, Default flow. ") + (if model = null or count(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"]) = 0 then "" else "Result variables missing: " + string join(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"], ", ") + ". Check the script tasks (Result variable). ")' resultVariable="fbRoute" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_EmptyXml3_FbRoute</bpmn:incoming>
        <bpmn:incoming>Flow_GetXml3_FbRoute</bpmn:incoming>
        <bpmn:outgoing>Flow_FbRoute_GwRoute</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwRoute" name="Step passed?" default="Flow_GwRoute_Route">
        <bpmn:incoming>Flow_FbRoute_GwRoute</bpmn:incoming>
        <bpmn:outgoing>Flow_GwRoute_RouteDecideEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwRoute_Route</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_RouteDecideStart_Route" sourceRef="RouteDecideStart" targetRef="Route" />
      <bpmn:sequenceFlow id="Flow_NoXml3_EmptyXml3" sourceRef="NoXml3" targetRef="EmptyXml3" />
      <bpmn:sequenceFlow id="Flow_EmptyXml3_FbRoute" sourceRef="EmptyXml3" targetRef="FbRoute" />
      <bpmn:sequenceFlow id="Flow_Route_CheckLatest3" sourceRef="Route" targetRef="CheckLatest3" />
      <bpmn:sequenceFlow id="Flow_CheckLatest3_GetXml3" sourceRef="CheckLatest3" targetRef="GetXml3" />
      <bpmn:sequenceFlow id="Flow_GetXml3_FbRoute" sourceRef="GetXml3" targetRef="FbRoute" />
      <bpmn:sequenceFlow id="Flow_FbRoute_GwRoute" sourceRef="FbRoute" targetRef="GwRoute" />
      <bpmn:sequenceFlow id="Flow_GwRoute_RouteDecideEnd" name="yes" sourceRef="GwRoute" targetRef="RouteDecideEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbRoute = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwRoute_Route" name="not yet" sourceRef="GwRoute" targetRef="Route" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Notify" name="4 Notifications">
      <bpmn:incoming>Flow_RouteDecide_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_RunThree</bpmn:outgoing>
      <bpmn:startEvent id="NotifyStart">
        <bpmn:outgoing>Flow_NotifyStart_Notif</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="NotifyEnd" name="Step done">
        <bpmn:incoming>Flow_GwNotif_NotifyEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckLatest4" name="Check: the latest version">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId, isLatestVersion: true}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={latestDef: response.body.items[1]}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Notif_CheckLatest4</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLatest4_GetXml4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetXml4" name="Check: read its model">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + (if latestDef = null then "0" else latestDef.processDefinitionKey) + "/xml"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={model: {x: if response.body = null then "" else string(response.body), n: function(s, p) count(split(s, p)) - 1, out: {xorCount: n(x, "&lt;(bpmn:)?exclusiveGateway[ &gt;/]"), xorDefaults: n(x, "&lt;(bpmn:)?exclusiveGateway[^&gt;]*default="), orCount: n(x, "&lt;(bpmn:)?inclusiveGateway[ &gt;/]"), andCount: n(x, "&lt;(bpmn:)?parallelGateway[ &gt;/]"), missing: (for k in ["certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"] return if contains(x, "resultVariable=\"" + k + "\"") then null else k)[item != null]}}.out}' /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NO_MODEL", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLatest4_GetXml4</bpmn:incoming>
        <bpmn:outgoing>Flow_GetXml4_FbNotif</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="NoXml4" name="No model" attachedToRef="GetXml4">
        <bpmn:outgoing>Flow_NoXml4_EmptyXml4</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_NoXml4" errorRef="Error_NO_MODEL" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="EmptyXml4" name="Note: no model">
        <bpmn:extensionElements><zeebe:script expression="=null" resultVariable="model" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoXml4_EmptyXml4</bpmn:incoming>
        <bpmn:outgoing>Flow_EmptyXml4_FbNotif</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Notif" name="S03 · 4 Notifications">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-notify" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NotifyStart_Notif</bpmn:incoming>
        <bpmn:incoming>Flow_GwNotif_Notif</bpmn:incoming>
        <bpmn:outgoing>Flow_Notif_CheckLatest4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbNotif" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (model != null) and (model = null or model.orCount &gt;= 2) and (model = null or model.andCount = 0) and (model = null or count(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"]) = 0) then "" else "Not yet. " + (if model != null then "" else "The engine has no deployed version of " + cfg.caseId + ". Deploy your thread-s03.bpmn (rocket icon) and wait a few seconds. ") + (if model = null or model.orCount &gt;= 2 then "" else "Your latest version needs two inclusive gateways: Who must be informed? and the join before the end. ") + (if model = null or model.andCount = 0 then "" else "Your model has a parallel gateway. Today none is needed: the three paths of the merge never run together, and a parallel join would wait forever. ") + (if model = null or count(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"]) = 0 then "" else "Result variables missing: " + string join(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"], ", ") + ". Check the three Notify tasks. ")' resultVariable="fbNotif" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_EmptyXml4_FbNotif</bpmn:incoming>
        <bpmn:incoming>Flow_GetXml4_FbNotif</bpmn:incoming>
        <bpmn:outgoing>Flow_FbNotif_GwNotif</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwNotif" name="Step passed?" default="Flow_GwNotif_Notif">
        <bpmn:incoming>Flow_FbNotif_GwNotif</bpmn:incoming>
        <bpmn:outgoing>Flow_GwNotif_NotifyEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwNotif_Notif</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_NotifyStart_Notif" sourceRef="NotifyStart" targetRef="Notif" />
      <bpmn:sequenceFlow id="Flow_NoXml4_EmptyXml4" sourceRef="NoXml4" targetRef="EmptyXml4" />
      <bpmn:sequenceFlow id="Flow_EmptyXml4_FbNotif" sourceRef="EmptyXml4" targetRef="FbNotif" />
      <bpmn:sequenceFlow id="Flow_Notif_CheckLatest4" sourceRef="Notif" targetRef="CheckLatest4" />
      <bpmn:sequenceFlow id="Flow_CheckLatest4_GetXml4" sourceRef="CheckLatest4" targetRef="GetXml4" />
      <bpmn:sequenceFlow id="Flow_GetXml4_FbNotif" sourceRef="GetXml4" targetRef="FbNotif" />
      <bpmn:sequenceFlow id="Flow_FbNotif_GwNotif" sourceRef="FbNotif" targetRef="GwNotif" />
      <bpmn:sequenceFlow id="Flow_GwNotif_NotifyEnd" name="yes" sourceRef="GwNotif" targetRef="NotifyEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbNotif = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwNotif_Notif" name="not yet" sourceRef="GwNotif" targetRef="Notif" />
    </bpmn:subProcess>
    <bpmn:subProcess id="RunThree" name="5 Run three instances">
      <bpmn:incoming>Flow_Notify_RunThree</bpmn:incoming>
      <bpmn:outgoing>Flow_RunThree_BreakIt</bpmn:outgoing>
      <bpmn:startEvent id="RunThreeStart">
        <bpmn:outgoing>Flow_RunThreeStart_Runs</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="RunThreeEnd" name="Step done">
        <bpmn:incoming>Flow_GwRuns_RunThreeEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckRuns" name="Check: the last completed instances">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-instances/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, state: "COMPLETED"}, sort: [{field: "endDate", order: "desc"}], page: {limit: 50}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={runKeys: if count(response.body.items) = 0 then ["0"] else response.body.items.processInstanceKey}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Runs_CheckRuns</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckRuns_CheckRunsVars</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckRunsVars" name="Check: their variables">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/variables/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processInstanceKey: {"$in": runKeys}, name: {"$in": ["requestType",  "decision",  "certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"]}}, page: {limit: 1000}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={runs: {u: function(x) if x = null then null else if starts with(x, "\"") then substring(x, 2, string length(x) - 2) else x, it: response.body.items, keys: distinct values(it.processInstanceKey), runs: for k in keys return {vs: it[processInstanceKey = k], names: vs.name, type: u((vs[name = "requestType"].value)[1]), decision: u((vs[name = "decision"].value)[1]), cert: u((vs[name = "certificateNumber"].value)[1])}, out: {count: count(keys), cert: some r in runs satisfies r.type = "certificate" and r.cert != null and starts with(r.cert, "CERT-") and list contains(r.names, "studentMessage") and not(list contains(r.names, "decision")) and not(list contains(r.names, "instructorMessage")) and not(list contains(r.names, "registrarMessage")), post: some r in runs satisfies r.type = "postponement" and r.decision = "approved" and list contains(r.names, "registered") and list contains(r.names, "studentMessage") and list contains(r.names, "instructorMessage") and not(list contains(r.names, "registrarMessage")), rec: some r in runs satisfies r.type = "recognition" and r.decision = "rejected" and list contains(r.names, "letter") and list contains(r.names, "studentMessage") and not(list contains(r.names, "instructorMessage")) and not(list contains(r.names, "registrarMessage"))}}.out}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckRuns_CheckRunsVars</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckRunsVars_FbRuns</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Runs" name="S03 · 5 Run three instances">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-runs" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_RunThreeStart_Runs</bpmn:incoming>
        <bpmn:incoming>Flow_GwRuns_Runs</bpmn:incoming>
        <bpmn:outgoing>Flow_Runs_CheckRuns</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbRuns" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (runs.cert) and (runs.post) and (runs.rec) and (count(cpPost) = 2 and list contains(cpPost, "student") and list contains(cpPost, "instructor")) and (cpRec = "one") then "" else "Not yet. " + (if runs.cert then "" else "No completed certificate instance of " + cfg.caseId + " that issued a certificate (CERT-...) and notified only the student. Start one with requestType certificate. ") + (if runs.post then "" else "No completed postponement instance that was approved, registered and notified the student and the instructor (and not the registrar). ") + (if runs.rec then "" else "No completed recognition instance that was rejected, has a letter and notified only the student. ") + (if count(cpPost) = 2 and list contains(cpPost, "student") and list contains(cpPost, "instructor") then "" else "Checkpoint 1: open instance 2 in Operate and look at the highlighted path after the inclusive gateway. ") + (if cpRec = "one" then "" else "Checkpoint 2: count the branches instance 3 took at the inclusive gateway. ")' resultVariable="fbRuns" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckRunsVars_FbRuns</bpmn:incoming>
        <bpmn:outgoing>Flow_FbRuns_GwRuns</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwRuns" name="Step passed?" default="Flow_GwRuns_Runs">
        <bpmn:incoming>Flow_FbRuns_GwRuns</bpmn:incoming>
        <bpmn:outgoing>Flow_GwRuns_RunThreeEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwRuns_Runs</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_RunThreeStart_Runs" sourceRef="RunThreeStart" targetRef="Runs" />
      <bpmn:sequenceFlow id="Flow_Runs_CheckRuns" sourceRef="Runs" targetRef="CheckRuns" />
      <bpmn:sequenceFlow id="Flow_CheckRuns_CheckRunsVars" sourceRef="CheckRuns" targetRef="CheckRunsVars" />
      <bpmn:sequenceFlow id="Flow_CheckRunsVars_FbRuns" sourceRef="CheckRunsVars" targetRef="FbRuns" />
      <bpmn:sequenceFlow id="Flow_FbRuns_GwRuns" sourceRef="FbRuns" targetRef="GwRuns" />
      <bpmn:sequenceFlow id="Flow_GwRuns_RunThreeEnd" name="yes" sourceRef="GwRuns" targetRef="RunThreeEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbRuns = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwRuns_Runs" name="not yet" sourceRef="GwRuns" targetRef="Runs" />
    </bpmn:subProcess>
    <bpmn:subProcess id="BreakIt" name="6 Break it and repair it">
      <bpmn:incoming>Flow_RunThree_BreakIt</bpmn:incoming>
      <bpmn:outgoing>Flow_BreakIt_Review</bpmn:outgoing>
      <bpmn:startEvent id="BreakItStart">
        <bpmn:outgoing>Flow_BreakItStart_Break</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="BreakItEnd" name="Step done">
        <bpmn:incoming>Flow_GwBreak_BreakItEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckIncident" name="Check: a condition incident">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/incidents/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, errorType: "CONDITION_ERROR"}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={conditionIncidents: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Break_CheckIncident</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckIncident_CheckOpen</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckOpen" name="Check: none left open">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/incidents/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, errorType: "CONDITION_ERROR", state: "ACTIVE"}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={openIncidents: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckIncident_CheckOpen</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckOpen_CheckLatest6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckLatest6" name="Check: the latest version">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId, isLatestVersion: true}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={latestDef: response.body.items[1]}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckOpen_CheckLatest6</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLatest6_GetXml6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetXml6" name="Check: read its model">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + (if latestDef = null then "0" else latestDef.processDefinitionKey) + "/xml"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={model: {x: if response.body = null then "" else string(response.body), n: function(s, p) count(split(s, p)) - 1, out: {xorCount: n(x, "&lt;(bpmn:)?exclusiveGateway[ &gt;/]"), xorDefaults: n(x, "&lt;(bpmn:)?exclusiveGateway[^&gt;]*default="), orCount: n(x, "&lt;(bpmn:)?inclusiveGateway[ &gt;/]"), andCount: n(x, "&lt;(bpmn:)?parallelGateway[ &gt;/]"), missing: (for k in ["certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"] return if contains(x, "resultVariable=\"" + k + "\"") then null else k)[item != null]}}.out}' /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NO_MODEL", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLatest6_GetXml6</bpmn:incoming>
        <bpmn:outgoing>Flow_GetXml6_FbBreak</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="NoXml6" name="No model" attachedToRef="GetXml6">
        <bpmn:outgoing>Flow_NoXml6_EmptyXml6</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_NoXml6" errorRef="Error_NO_MODEL" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="EmptyXml6" name="Note: no model">
        <bpmn:extensionElements><zeebe:script expression="=null" resultVariable="model" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoXml6_EmptyXml6</bpmn:incoming>
        <bpmn:outgoing>Flow_EmptyXml6_FbBreak</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Break" name="S03 · 6 Break it and repair it">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-break" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_BreakItStart_Break</bpmn:incoming>
        <bpmn:incoming>Flow_GwBreak_Break</bpmn:incoming>
        <bpmn:outgoing>Flow_Break_CheckIncident</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbBreak" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (deployError = "rejected") and (conditionIncidents &gt;= 1) and (incidentMsg = "noFlow") and (openIncidents = 0) and (model = null or model.xorDefaults &gt;= 2) then "" else "Not yet. " + (if deployError = "rejected" then "" else "Question 1: read the message the Modeler shows when the deploy fails. ") + (if conditionIncidents &gt;= 1 then "" else "The engine has no condition incident in " + cfg.caseId + ". Delete the arrow rejected, deploy, start a recognition instance and reject it in Tasklist. ") + (if incidentMsg = "noFlow" then "" else "Question 2: open the incident in Operate and read its message. ") + (if openIncidents = 0 then "" else "An instance of " + cfg.caseId + " is still stopped at an incident. Cancel it in Operate (Cancel instance). ") + (if model = null or model.xorDefaults &gt;= 2 then "" else "Your latest version still lacks a default flow. Put the arrow rejected back, mark it Default flow, and deploy again. ")' resultVariable="fbBreak" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_EmptyXml6_FbBreak</bpmn:incoming>
        <bpmn:incoming>Flow_GetXml6_FbBreak</bpmn:incoming>
        <bpmn:outgoing>Flow_FbBreak_GwBreak</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwBreak" name="Step passed?" default="Flow_GwBreak_Break">
        <bpmn:incoming>Flow_FbBreak_GwBreak</bpmn:incoming>
        <bpmn:outgoing>Flow_GwBreak_BreakItEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwBreak_Break</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_BreakItStart_Break" sourceRef="BreakItStart" targetRef="Break" />
      <bpmn:sequenceFlow id="Flow_NoXml6_EmptyXml6" sourceRef="NoXml6" targetRef="EmptyXml6" />
      <bpmn:sequenceFlow id="Flow_EmptyXml6_FbBreak" sourceRef="EmptyXml6" targetRef="FbBreak" />
      <bpmn:sequenceFlow id="Flow_Break_CheckIncident" sourceRef="Break" targetRef="CheckIncident" />
      <bpmn:sequenceFlow id="Flow_CheckIncident_CheckOpen" sourceRef="CheckIncident" targetRef="CheckOpen" />
      <bpmn:sequenceFlow id="Flow_CheckOpen_CheckLatest6" sourceRef="CheckOpen" targetRef="CheckLatest6" />
      <bpmn:sequenceFlow id="Flow_CheckLatest6_GetXml6" sourceRef="CheckLatest6" targetRef="GetXml6" />
      <bpmn:sequenceFlow id="Flow_GetXml6_FbBreak" sourceRef="GetXml6" targetRef="FbBreak" />
      <bpmn:sequenceFlow id="Flow_FbBreak_GwBreak" sourceRef="FbBreak" targetRef="GwBreak" />
      <bpmn:sequenceFlow id="Flow_GwBreak_BreakItEnd" name="yes" sourceRef="GwBreak" targetRef="BreakItEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbBreak = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwBreak_Break" name="not yet" sourceRef="GwBreak" targetRef="Break" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Review" name="7–8 Self-check and compare">
      <bpmn:incoming>Flow_BreakIt_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_SendResults</bpmn:outgoing>
      <bpmn:startEvent id="ReviewStart">
        <bpmn:outgoing>Flow_ReviewStart_SelfCheck</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="ReviewEnd" name="Step done">
        <bpmn:incoming>Flow_Compare_ReviewEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="SelfCheck" name="S03 · 7 Self-check">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-self-check" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ReviewStart_SelfCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_SelfCheck_Compare</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Compare" name="S03 · 8 Compare with the model answers">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-compare" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SelfCheck_Compare</bpmn:incoming>
        <bpmn:outgoing>Flow_Compare_ReviewEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_ReviewStart_SelfCheck" sourceRef="ReviewStart" targetRef="SelfCheck" />
      <bpmn:sequenceFlow id="Flow_SelfCheck_Compare" sourceRef="SelfCheck" targetRef="Compare" />
      <bpmn:sequenceFlow id="Flow_Compare_ReviewEnd" sourceRef="Compare" targetRef="ReviewEnd" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SendResults" name="Send the results">
      <bpmn:incoming>Flow_Review_SendResults</bpmn:incoming>
      <bpmn:outgoing>Flow_SendResults_End</bpmn:outgoing>
      <bpmn:startEvent id="SendResultsStart">
        <bpmn:outgoing>Flow_SendResultsStart_GwSend</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SendResultsEnd" name="Step done">
        <bpmn:incoming>Flow_GwSend_SendResultsEnd</bpmn:incoming>
        <bpmn:incoming>Flow_Send_SendResultsEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GwSend" name="Results sheet set?" default="Flow_GwSend_SendResultsEnd">
        <bpmn:incoming>Flow_SendResultsStart_GwSend</bpmn:incoming>
        <bpmn:outgoing>Flow_GwSend_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwSend_SendResultsEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Send" name="Send the results to the teacher">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source="=cfg.resultsUrl" target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={token: "p2a-camunda-2026", session: "s03", finishedAt: string(now()), rut: rut, lastName: lastName, firstName: firstName, studentEmail: studentEmail, a1: a1, a2: string join(a2, "+"), a2b: a2b, a3: a3, ex1: ex1, ex2: ex2, ex3: ex3, sc1: sc1, sc2: sc2, sc3: sc3, feelSafe: feelSafe, cpPost: string join(cpPost, "+"), cpRec: cpRec, deployError: deployError, incidentMsg: incidentMsg, self1: self1, self2: self2, self3: self3, rateSelf1: rateSelf1, rateSelf2: rateSelf2, rateSelf3: rateSelf3}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="errorExpression" value='=if error != null then bpmnError("SEND_FAILED", error.message) else null' /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_GwSend_Send</bpmn:incoming>
        <bpmn:outgoing>Flow_Send_SendResultsEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SendFailed" name="Not sent" attachedToRef="Send">
        <bpmn:outgoing>Flow_SendFailed_TellTeacher</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_SendFailed" errorRef="Error_SEND_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="TellTeacher" name="S03 · Results not sent: tell the teacher">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-not-sent" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SendFailed_TellTeacher</bpmn:incoming>
        <bpmn:outgoing>Flow_TellTeacher_SendResultsNotSent</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SendResultsNotSent" name="Teacher told">
        <bpmn:incoming>Flow_TellTeacher_SendResultsNotSent</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SendResultsStart_GwSend" sourceRef="SendResultsStart" targetRef="GwSend" />
      <bpmn:sequenceFlow id="Flow_SendFailed_TellTeacher" sourceRef="SendFailed" targetRef="TellTeacher" />
      <bpmn:sequenceFlow id="Flow_GwSend_Send" name="yes" sourceRef="GwSend" targetRef="Send">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cfg.resultsUrl != ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwSend_SendResultsEnd" name="no" sourceRef="GwSend" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_Send_SendResultsEnd" sourceRef="Send" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_TellTeacher_SendResultsNotSent" sourceRef="TellTeacher" targetRef="SendResultsNotSent" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End" name="Class completed">
      <bpmn:incoming>Flow_SendResults_End</bpmn:incoming>
    </bpmn:endEvent>
