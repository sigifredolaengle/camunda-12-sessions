<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_class-s03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="class-s03" name="S03 · End-of-session check" isExecutable="true">
    <bpmn:documentation>Session 3: the engine checks the student's work at the end of the class.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Class started">
      <bpmn:extensionElements><zeebe:formDefinition formId="class-s03-start" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Config</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Config" name="Prepare the class">
      <bpmn:extensionElements><zeebe:script expression='={caseId: if caseId = null then "student-request" else caseId, testId: if testId = null then "student-request-test" else testId, engineUrl: if engineUrl = null then "http://localhost:8080" else engineUrl, resultsUrl: if resultsUrl = null then "https://script.google.com/macros/s/AKfycbw_pq8bBmwMYtrJ2wetrkkOOZX0nojMt2kow3qfleQh3NQbiI7NDzXuL4SeVliYpBI/exec" else resultsUrl}' resultVariable="cfg" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Config</bpmn:incoming>
      <bpmn:outgoing>Flow_Config_CheckWork</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="CheckWork" name="Check your work">
      <bpmn:incoming>Flow_Config_CheckWork</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckWork_SendResults</bpmn:outgoing>
      <bpmn:startEvent id="CheckWorkStart">
        <bpmn:outgoing>Flow_CheckWorkStart_Check</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="CheckWorkEnd" name="Step done">
        <bpmn:incoming>Flow_GwCheck_CheckWorkEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="CheckRuns" name="Check: the last completed instances">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-instances/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, state: "COMPLETED"}, sort: [{field: "endDate", order: "desc"}], page: {limit: 50}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={runKeys: if count(response.body.items) = 0 then ["0"] else response.body.items.processInstanceKey}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Check_CheckRuns</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckRuns_CheckRunsVars</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckRunsVars" name="Check: their variables">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/variables/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processInstanceKey: {"$in": runKeys}, name: {"$in": ["requestType",  "decision",  "certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"]}}, page: {limit: 1000}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={runs: {u: function(x) if x = null then null else if starts with(x, "\"") then substring(x, 2, string length(x) - 2) else x, it: response.body.items, keys: distinct values(it.processInstanceKey), runs: for k in keys return {vs: it[processInstanceKey = k], names: vs.name, type: u((vs[name = "requestType"].value)[1]), decision: u((vs[name = "decision"].value)[1]), cert: u((vs[name = "certificateNumber"].value)[1])}, out: {count: count(keys), cert: some r in runs satisfies r.type = "certificate" and r.cert != null and starts with(r.cert, "CERT-") and list contains(r.names, "studentMessage") and not(list contains(r.names, "decision")) and not(list contains(r.names, "instructorMessage")) and not(list contains(r.names, "registrarMessage")), post: some r in runs satisfies r.type = "postponement" and r.decision = "approved" and list contains(r.names, "registered") and list contains(r.names, "studentMessage") and list contains(r.names, "instructorMessage") and not(list contains(r.names, "registrarMessage")), rec: some r in runs satisfies r.type = "recognition" and r.decision = "rejected" and list contains(r.names, "letter") and list contains(r.names, "studentMessage") and not(list contains(r.names, "instructorMessage")) and not(list contains(r.names, "registrarMessage"))}}.out}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckRuns_CheckRunsVars</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckRunsVars_CheckIncident</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckIncident" name="Check: a condition incident">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/incidents/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, errorType: "CONDITION_ERROR"}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={conditionIncidents: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckRunsVars_CheckIncident</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckIncident_CheckOpen</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckOpen" name="Check: none left open">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/incidents/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId, errorType: "CONDITION_ERROR", state: "ACTIVE"}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={openIncidents: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckIncident_CheckOpen</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckOpen_CheckLatest</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="CheckLatest" name="Check: the latest version">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId, isLatestVersion: true}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={latestDef: response.body.items[1]}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckOpen_CheckLatest</bpmn:incoming>
        <bpmn:outgoing>Flow_CheckLatest_GetXml</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="GetXml" name="Check: read its model">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + (if latestDef = null then "0" else latestDef.processDefinitionKey) + "/xml"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={model: {x: if response.body = null then "" else string(response.body), n: function(s, p) count(split(s, p)) - 1, out: {xorCount: n(x, "&lt;(bpmn:)?exclusiveGateway[ &gt;/]"), xorDefaults: n(x, "&lt;(bpmn:)?exclusiveGateway[^&gt;]*default="), orCount: n(x, "&lt;(bpmn:)?inclusiveGateway[ &gt;/]"), andCount: n(x, "&lt;(bpmn:)?parallelGateway[ &gt;/]"), missing: (for k in ["certificateNumber",  "registered",  "letter",  "studentMessage",  "instructorMessage",  "registrarMessage"] return if contains(x, "resultVariable=\"" + k + "\"") then null else k)[item != null]}}.out}' /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("NO_MODEL", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckLatest_GetXml</bpmn:incoming>
        <bpmn:outgoing>Flow_GetXml_FbCheck</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="NoXml" name="No model" attachedToRef="GetXml">
        <bpmn:outgoing>Flow_NoXml_EmptyXml</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_NoXml" errorRef="Error_NO_MODEL" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="EmptyXml" name="Note: no model">
        <bpmn:extensionElements><zeebe:script expression="=null" resultVariable="model" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NoXml_EmptyXml</bpmn:incoming>
        <bpmn:outgoing>Flow_EmptyXml_FbCheck</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Check" name="S03 · Check your work">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-check" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckWorkStart_Check</bpmn:incoming>
        <bpmn:incoming>Flow_GwCheck_Check</bpmn:incoming>
        <bpmn:outgoing>Flow_Check_CheckRuns</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="FbCheck" name="Check the answers">
        <bpmn:extensionElements><zeebe:script expression='=if (model != null) and (model = null or model.xorCount &gt;= 3) and (model = null or model.xorDefaults &gt;= 2) and (model = null or count(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"]) = 0) and (model = null or model.orCount &gt;= 2) and (model = null or model.andCount = 0) and (model = null or count(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"]) = 0) and (runs.cert) and (runs.post) and (runs.rec) and (conditionIncidents &gt;= 1) and (openIncidents = 0) then "" else "Not yet. " + (if model != null then "" else "The engine has no deployed version of `" + cfg.caseId + "`. Deploy your `thread-s03.bpmn` (rocket icon) and wait a few seconds. ") + (if model = null or model.xorCount &gt;= 3 then "" else "Step 3: your latest version has " + string(model.xorCount) + " exclusive gateways; it needs three: `Type of request?`, `Approved?` and the merge. Did you deploy after saving? After a deploy, wait a few seconds. ") + (if model = null or model.xorDefaults &gt;= 2 then "" else "Steps 3 and 6: `Type of request?` and `Approved?` each need a default flow: select the arrow, wrench icon, Default flow. ") + (if model = null or count(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"]) = 0 then "" else "Step 3: result variables missing: `" + string join(model.missing[item = "certificateNumber" or item = "registered" or item = "letter"], "`, `") + "`. Check the script tasks (Result variable). ") + (if model = null or model.orCount &gt;= 2 then "" else "Step 4: your latest version needs two inclusive gateways: `Who must be informed?` and the join before `Request closed`. ") + (if model = null or model.andCount = 0 then "" else "Step 4: your model has a parallel gateway. None is needed: the three paths of the merge never run together, and a parallel join would wait forever. ") + (if model = null or count(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"]) = 0 then "" else "Step 4: result variables missing: `" + string join(model.missing[item = "studentMessage" or item = "instructorMessage" or item = "registrarMessage"], "`, `") + "`. Check `Notify student`, `Notify instructor` and `Notify registrar`. ") + (if runs.cert then "" else "Step 5: no completed instance of `" + cfg.caseId + "` with `requestType` = `\"certificate\"` that passed `Issue certificate` (`certificateNumber` = `\"CERT-...\"`) and, of the notifications, only `Notify student`. ") + (if runs.post then "" else "Step 5: no completed instance with `requestType` = `\"postponement\"` and `decision` = `\"approved\"` that passed `Register decision`, `Notify student` and `Notify instructor` (and not `Notify registrar`). ") + (if runs.rec then "" else "Step 5: no completed instance with `requestType` = `\"recognition\"` and `decision` = `\"rejected\"` that passed `Prepare rejection letter` and, of the notifications, only `Notify student`. ") + (if conditionIncidents &gt;= 1 then "" else "Step 6: the engine has no condition incident in `" + cfg.caseId + "`. Delete the arrow `rejected`, deploy, start an instance with `requestType` = `\"recognition\"` and, in Tasklist, choose `decision` = `\"rejected\"`. ") + (if openIncidents = 0 then "" else "Step 6: an instance of `" + cfg.caseId + "` is still stopped at an incident. Cancel it in Operate (Cancel instance). ")' resultVariable="fbCheck" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_EmptyXml_FbCheck</bpmn:incoming>
        <bpmn:incoming>Flow_GetXml_FbCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_FbCheck_GwCheck</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="GwCheck" name="Step passed?" default="Flow_GwCheck_Check">
        <bpmn:incoming>Flow_FbCheck_GwCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_GwCheck_CheckWorkEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwCheck_Check</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_CheckWorkStart_Check" sourceRef="CheckWorkStart" targetRef="Check" />
      <bpmn:sequenceFlow id="Flow_NoXml_EmptyXml" sourceRef="NoXml" targetRef="EmptyXml" />
      <bpmn:sequenceFlow id="Flow_EmptyXml_FbCheck" sourceRef="EmptyXml" targetRef="FbCheck" />
      <bpmn:sequenceFlow id="Flow_Check_CheckRuns" sourceRef="Check" targetRef="CheckRuns" />
      <bpmn:sequenceFlow id="Flow_CheckRuns_CheckRunsVars" sourceRef="CheckRuns" targetRef="CheckRunsVars" />
      <bpmn:sequenceFlow id="Flow_CheckRunsVars_CheckIncident" sourceRef="CheckRunsVars" targetRef="CheckIncident" />
      <bpmn:sequenceFlow id="Flow_CheckIncident_CheckOpen" sourceRef="CheckIncident" targetRef="CheckOpen" />
      <bpmn:sequenceFlow id="Flow_CheckOpen_CheckLatest" sourceRef="CheckOpen" targetRef="CheckLatest" />
      <bpmn:sequenceFlow id="Flow_CheckLatest_GetXml" sourceRef="CheckLatest" targetRef="GetXml" />
      <bpmn:sequenceFlow id="Flow_GetXml_FbCheck" sourceRef="GetXml" targetRef="FbCheck" />
      <bpmn:sequenceFlow id="Flow_FbCheck_GwCheck" sourceRef="FbCheck" targetRef="GwCheck" />
      <bpmn:sequenceFlow id="Flow_GwCheck_CheckWorkEnd" name="yes" sourceRef="GwCheck" targetRef="CheckWorkEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbCheck = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwCheck_Check" name="not yet" sourceRef="GwCheck" targetRef="Check" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SendResults" name="Send the results">
      <bpmn:incoming>Flow_CheckWork_SendResults</bpmn:incoming>
      <bpmn:outgoing>Flow_SendResults_End</bpmn:outgoing>
      <bpmn:startEvent id="SendResultsStart">
        <bpmn:outgoing>Flow_SendResultsStart_GwSend</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SendResultsEnd" name="Step done">
        <bpmn:incoming>Flow_GwSend_SendResultsEnd</bpmn:incoming>
        <bpmn:incoming>Flow_Send_SendResultsEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="GwSend" name="Results sheet set?" default="Flow_GwSend_SendResultsEnd">
        <bpmn:incoming>Flow_SendResultsStart_GwSend</bpmn:incoming>
        <bpmn:outgoing>Flow_GwSend_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_GwSend_SendResultsEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Send" name="Send the results to the teacher">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source="=cfg.resultsUrl" target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={token: "p2a-camunda-2026", session: "s03", finishedAt: string(now()), rut: rut, lastName: lastName, firstName: firstName, studentEmail: studentEmail, result: "all checks passed"}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="errorExpression" value='=if error != null then bpmnError("SEND_FAILED", error.message) else null' /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_GwSend_Send</bpmn:incoming>
        <bpmn:outgoing>Flow_Send_SendResultsEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SendFailed" name="Not sent" attachedToRef="Send">
        <bpmn:outgoing>Flow_SendFailed_TellTeacher</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_SendFailed" errorRef="Error_SEND_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="TellTeacher" name="S03 · Results not sent: tell the teacher">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-not-sent" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SendFailed_TellTeacher</bpmn:incoming>
        <bpmn:outgoing>Flow_TellTeacher_SendResultsNotSent</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SendResultsNotSent" name="Teacher told">
        <bpmn:incoming>Flow_TellTeacher_SendResultsNotSent</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_SendResultsStart_GwSend" sourceRef="SendResultsStart" targetRef="GwSend" />
      <bpmn:sequenceFlow id="Flow_SendFailed_TellTeacher" sourceRef="SendFailed" targetRef="TellTeacher" />
      <bpmn:sequenceFlow id="Flow_GwSend_Send" name="yes" sourceRef="GwSend" targetRef="Send">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cfg.resultsUrl != ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_GwSend_SendResultsEnd" name="no" sourceRef="GwSend" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_Send_SendResultsEnd" sourceRef="Send" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_TellTeacher_SendResultsNotSent" sourceRef="TellTeacher" targetRef="SendResultsNotSent" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End" name="Check completed">
      <bpmn:incoming>Flow_SendResults_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Config" sourceRef="Start" targetRef="Config" />
    <bpmn:sequenceFlow id="Flow_Config_CheckWork" sourceRef="Config" targetRef="CheckWork" />
    <bpmn:sequenceFlow id="Flow_CheckWork_SendResults" sourceRef="CheckWork" targetRef="SendResults" />
    <bpmn:sequenceFlow id="Flow_SendResults_End" sourceRef="SendResults" targetRef="End" />
  </bpmn:process>
  <bpmn:error id="Error_NO_MODEL" name="No model" errorCode="NO_MODEL" />
  <bpmn:error id="Error_SEND_FAILED" name="Results not sent" errorCode="SEND_FAILED" />
  <bpmndi:BPMNDiagram id="Diagram_class_s03">
    <bpmndi:BPMNPlane id="Plane_class_s03" bpmnElement="class-s03">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="127" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Config_di" bpmnElement="Config"><dc:Bounds x="260" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckWork_di" bpmnElement="CheckWork" isExpanded="false"><dc:Bounds x="430" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendResults_di" bpmnElement="SendResults" isExpanded="false"><dc:Bounds x="600" y="105" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="807" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Config_di" bpmnElement="Flow_Start_Config"><di:waypoint x="163" y="145" /><di:waypoint x="260" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Config_CheckWork_di" bpmnElement="Flow_Config_CheckWork"><di:waypoint x="370" y="145" /><di:waypoint x="430" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckWork_SendResults_di" bpmnElement="Flow_CheckWork_SendResults"><di:waypoint x="540" y="145" /><di:waypoint x="600" y="145" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendResults_End_di" bpmnElement="Flow_SendResults_End"><di:waypoint x="710" y="145" /><di:waypoint x="807" y="145" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_CheckWork">
    <bpmndi:BPMNPlane id="Plane_CheckWork" bpmnElement="CheckWork">
      <bpmndi:BPMNShape id="CheckWorkStart_di" bpmnElement="CheckWorkStart"><dc:Bounds x="127" y="127" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check"><dc:Bounds x="260" y="105" width="110" height="80" /></bpmndi:BPMNShape>
