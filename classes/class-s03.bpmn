<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_class-s03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="class-s03" name="S03 · End-of-session check" isExecutable="true">
    <bpmn:documentation>Final check, independent study and receipted delivery; no worker required.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Class started">
      <bpmn:extensionElements><zeebe:formDefinition formId="class-s03-start" /></bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Config</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Config" name="Prepare the class">
      <bpmn:extensionElements><zeebe:script expression='={caseId: if caseId = null then "student-request" else caseId, testId: if testId = null then "student-request-test" else testId, engineUrl: if engineUrl = null then "http://localhost:8080" else engineUrl, resultsUrl: if resultsUrl = null then "https://script.google.com/macros/s/AKfycbw_pq8bBmwMYtrJ2wetrkkOOZX0nojMt2kow3qfleQh3NQbiI7NDzXuL4SeVliYpBI/exec" else resultsUrl}' resultVariable="cfg" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Config</bpmn:incoming>
      <bpmn:outgoing>Flow_Config_CheckWork</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="CheckWork" name="Check your work">
      <bpmn:incoming>Flow_Config_CheckWork</bpmn:incoming>
      <bpmn:incoming>Flow_Outcome_CheckWork</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckWork_Snapshot</bpmn:outgoing>
      <bpmn:startEvent id="CheckWorkStart">
        <bpmn:outgoing>Flow_CheckWorkStart_Check</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="CheckWorkEnd" name="Step done">
        <bpmn:incoming>Flow_Passed_CheckWorkEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="Check" name="S03 · Check your work">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-check" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_CheckWorkStart_Check</bpmn:incoming>
        <bpmn:incoming>Flow_NoDefinition_Check</bpmn:incoming>
        <bpmn:incoming>Flow_Passed_Check</bpmn:incoming>
        <bpmn:outgoing>Flow_Check_SelectVersion</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="SelectVersion" name="Choose the version">
        <bpmn:extensionElements><zeebe:script expression='=if assessedVersion = null or assessedVersion = "" then null else number(assessedVersion)' resultVariable="selectedVersion" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Check_SelectVersion</bpmn:incoming>
        <bpmn:outgoing>Flow_SelectVersion_Definitions</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Definitions" name="Read the deployed versions">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId}, page: {limit: 1000}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={definitions: response.body.items, definitionCount: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_SelectVersion_Definitions</bpmn:incoming>
        <bpmn:outgoing>Flow_Definitions_SelectDefinition</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="SelectDefinition" name="Select the assessed definition">
        <bpmn:extensionElements><zeebe:script expression="={ds: if selectedVersion = null then definitions[isLatestVersion = true] else definitions[version = selectedVersion], found: ds[1]}.found" resultVariable="assessedDefinition" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Definitions_SelectDefinition</bpmn:incoming>
        <bpmn:outgoing>Flow_SelectDefinition_FoundDefinition</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="FoundDefinition" name="Version found?" default="Flow_FoundDefinition_NoDefinition">
        <bpmn:incoming>Flow_SelectDefinition_FoundDefinition</bpmn:incoming>
        <bpmn:outgoing>Flow_FoundDefinition_ModelXml</bpmn:outgoing>
        <bpmn:outgoing>Flow_FoundDefinition_NoDefinition</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ModelXml" name="Read the assessed model">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-definitions/" + assessedDefinition.processDefinitionKey + "/xml"' target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={modelXml: string(response.body)}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("READ_FAILED", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_FoundDefinition_ModelXml</bpmn:incoming>
        <bpmn:outgoing>Flow_ModelXml_Instances</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="XmlFailed" name="Model unavailable" attachedToRef="ModelXml">
        <bpmn:outgoing>Flow_XmlFailed_NoDefinition</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_XmlFailed" errorRef="Error_READ_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:scriptTask id="NoDefinition" name="Show the missing-version feedback">
        <bpmn:extensionElements><zeebe:script expression='="No deployed version was found. Deploy the session model, wait a few seconds, and select its version in Operate."' resultVariable="fbCheck" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_FoundDefinition_NoDefinition</bpmn:incoming>
        <bpmn:incoming>Flow_XmlFailed_NoDefinition</bpmn:incoming>
        <bpmn:outgoing>Flow_NoDefinition_Check</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Instances" name="Read the instances">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/process-instances/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processDefinitionId: cfg.caseId}, sort: [{field: "startDate", order: "desc"}], page: {limit: 1000}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value='={labInstances: response.body.items, instanceCount: response.body.page.totalItems, runKeys: if count(response.body.items) = 0 then ["0"] else response.body.items.processInstanceKey}' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_ModelXml_Instances</bpmn:incoming>
        <bpmn:outgoing>Flow_Instances_History</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="History" name="Read the executed elements">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/element-instances/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processInstanceKey: runKey}, page: {limit: 1000}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={historyPage: response.body}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Instances_History</bpmn:incoming>
        <bpmn:outgoing>Flow_History_FlattenHistory</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true"><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=runKeys" inputElement="runKey" outputCollection="historyPages" outputElement="=historyPage" /></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="FlattenHistory" name="Collect the execution history">
        <bpmn:extensionElements><zeebe:script expression="={labElements: flatten(historyPages.items), elementCount: sum(historyPages.page.totalItems)}" resultVariable="historyData" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_History_FlattenHistory</bpmn:incoming>
        <bpmn:outgoing>Flow_FlattenHistory_ExportHistory</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="ExportHistory" name="Expose the collected history">
        <bpmn:extensionElements><zeebe:script expression="=historyData.labElements" resultVariable="labElements" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_FlattenHistory_ExportHistory</bpmn:incoming>
        <bpmn:outgoing>Flow_ExportHistory_ExportHistoryCount</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="ExportHistoryCount" name="Count the execution history">
        <bpmn:extensionElements><zeebe:script expression="=historyData.elementCount" resultVariable="elementCount" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_ExportHistory_ExportHistoryCount</bpmn:incoming>
        <bpmn:outgoing>Flow_ExportHistoryCount_Variables</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="Variables" name="Read the instance variables">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/variables/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={filter: {processInstanceKey: {"$in": runKeys}}, page: {limit: 10000}}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={labVariables: response.body.items, variableCount: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_ExportHistoryCount_Variables</bpmn:incoming>
        <bpmn:outgoing>Flow_Variables_Incidents</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Incidents" name="Read the incidents">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source='=cfg.engineUrl + "/v2/incidents/search"' target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source="={filter: {processDefinitionId: cfg.caseId}, page: {limit: 1000}}" target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={labIncidents: response.body.items, incidentCount: response.body.page.totalItems}" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Variables_Incidents</bpmn:incoming>
        <bpmn:outgoing>Flow_Incidents_Feedback</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="Feedback" name="Check the local evidence">
        <bpmn:extensionElements><zeebe:script expression='=if (definitionCount &lt;= count(definitions) and instanceCount &lt;= count(labInstances) and elementCount &lt;= count(labElements) and variableCount &lt;= count(labVariables) and incidentCount &lt;= count(labIncidents)) and (count(labInstances[state = "COMPLETED"]) &gt;= 4 and count(labIncidents[errorType = "CONDITION_ERROR"]) &gt;= 1 and count(labIncidents[state = "ACTIVE"]) = 0) then "" else "Steps 4.3, 5 and 6: finish the four required cases, create the condition incident, then cancel the broken instance. If the engine has more results than this check can read, use a clean local engine and replay this session; no partial search is accepted."' resultVariable="fbCheck" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Incidents_Feedback</bpmn:incoming>
        <bpmn:outgoing>Flow_Feedback_Passed</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="Passed" name="Local evidence ready?" default="Flow_Passed_Check">
        <bpmn:incoming>Flow_Feedback_Passed</bpmn:incoming>
        <bpmn:outgoing>Flow_Passed_CheckWorkEnd</bpmn:outgoing>
        <bpmn:outgoing>Flow_Passed_Check</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_CheckWorkStart_Check" sourceRef="CheckWorkStart" targetRef="Check" />
      <bpmn:sequenceFlow id="Flow_Check_SelectVersion" sourceRef="Check" targetRef="SelectVersion" />
      <bpmn:sequenceFlow id="Flow_SelectVersion_Definitions" sourceRef="SelectVersion" targetRef="Definitions" />
      <bpmn:sequenceFlow id="Flow_Definitions_SelectDefinition" sourceRef="Definitions" targetRef="SelectDefinition" />
      <bpmn:sequenceFlow id="Flow_SelectDefinition_FoundDefinition" sourceRef="SelectDefinition" targetRef="FoundDefinition" />
      <bpmn:sequenceFlow id="Flow_FoundDefinition_ModelXml" name="yes" sourceRef="FoundDefinition" targetRef="ModelXml">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=assessedDefinition != null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_FoundDefinition_NoDefinition" name="no" sourceRef="FoundDefinition" targetRef="NoDefinition" />
      <bpmn:sequenceFlow id="Flow_XmlFailed_NoDefinition" sourceRef="XmlFailed" targetRef="NoDefinition" />
      <bpmn:sequenceFlow id="Flow_NoDefinition_Check" sourceRef="NoDefinition" targetRef="Check" />
      <bpmn:sequenceFlow id="Flow_ModelXml_Instances" sourceRef="ModelXml" targetRef="Instances" />
      <bpmn:sequenceFlow id="Flow_Instances_History" sourceRef="Instances" targetRef="History" />
      <bpmn:sequenceFlow id="Flow_History_FlattenHistory" sourceRef="History" targetRef="FlattenHistory" />
      <bpmn:sequenceFlow id="Flow_FlattenHistory_ExportHistory" sourceRef="FlattenHistory" targetRef="ExportHistory" />
      <bpmn:sequenceFlow id="Flow_ExportHistory_ExportHistoryCount" sourceRef="ExportHistory" targetRef="ExportHistoryCount" />
      <bpmn:sequenceFlow id="Flow_ExportHistoryCount_Variables" sourceRef="ExportHistoryCount" targetRef="Variables" />
      <bpmn:sequenceFlow id="Flow_Variables_Incidents" sourceRef="Variables" targetRef="Incidents" />
      <bpmn:sequenceFlow id="Flow_Incidents_Feedback" sourceRef="Incidents" targetRef="Feedback" />
      <bpmn:sequenceFlow id="Flow_Feedback_Passed" sourceRef="Feedback" targetRef="Passed" />
      <bpmn:sequenceFlow id="Flow_Passed_CheckWorkEnd" name="yes" sourceRef="Passed" targetRef="CheckWorkEnd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fbCheck = ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Passed_Check" name="not yet" sourceRef="Passed" targetRef="Check" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="Snapshot" name="Record this approved attempt">
      <bpmn:extensionElements><zeebe:script expression='={at: string(now()), id: "s03-" + rut + "-" + at, proof: {definition: assessedDefinition, definitions: definitions, instances: labInstances, elements: labElements, variables: labVariables, incidents: labIncidents}}' resultVariable="submission" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_CheckWork_Snapshot</bpmn:incoming>
      <bpmn:outgoing>Flow_Snapshot_SendResults</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:subProcess id="SendResults" name="Send the result">
      <bpmn:incoming>Flow_Snapshot_SendResults</bpmn:incoming>
      <bpmn:outgoing>Flow_SendResults_Outcome</bpmn:outgoing>
      <bpmn:startEvent id="SendResultsStart">
        <bpmn:outgoing>Flow_SendResultsStart_CanSend</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="SendResultsEnd" name="Step done">
        <bpmn:incoming>Flow_SetServerFeedback_SendResultsEnd</bpmn:incoming>
        <bpmn:incoming>Flow_Receipt_SendResultsEnd</bpmn:incoming>
        <bpmn:incoming>Flow_Pending_SendResultsEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="CanSend" name="Results address configured?" default="Flow_CanSend_DeliveryHelp">
        <bpmn:incoming>Flow_SendResultsStart_CanSend</bpmn:incoming>
        <bpmn:outgoing>Flow_CanSend_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_CanSend_DeliveryHelp</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Send" name="Send this attempt">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="POST" target="method" /><zeebe:input source="=cfg.resultsUrl" target="url" /><zeebe:input source='={"Content-Type": "application/json"}' target="headers" /><zeebe:input source='={token: "p2a-camunda-2026", protocol: 2, session: "s03", attemptId: submission.id, finishedAt: submission.at, rut: rut, lastName: lastName, firstName: firstName, studentEmail: studentEmail, checkPassed: true, modelXml: modelXml, evidence: submission.proof}' target="body" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={replyUrl: if response.headers.Location != null then response.headers.Location else response.headers.location, receipt: response.body}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("SEND_FAILED", error.message) else null' /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_CanSend_Send</bpmn:incoming>
        <bpmn:incoming>Flow_NextAction_Send</bpmn:incoming>
        <bpmn:outgoing>Flow_Send_Redirect</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="SendFailed" name="Not sent" attachedToRef="Send">
        <bpmn:outgoing>Flow_SendFailed_TransportError</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_SendFailed" errorRef="Error_SEND_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Redirect" name="Read redirected reply?" default="Flow_Redirect_Accepted">
        <bpmn:incoming>Flow_Send_Redirect</bpmn:incoming>
        <bpmn:outgoing>Flow_Redirect_ReadReply</bpmn:outgoing>
        <bpmn:outgoing>Flow_Redirect_Accepted</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ReadReply" name="Read the receipt">
        <bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=replyUrl" target="url" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultExpression" value="={receipt: response.body}" /><zeebe:header key="errorExpression" value='=if error != null then bpmnError("SEND_FAILED", error.message) else null' /></zeebe:taskHeaders></bpmn:extensionElements>
        <bpmn:incoming>Flow_Redirect_ReadReply</bpmn:incoming>
        <bpmn:outgoing>Flow_ReadReply_Accepted</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="ReplyFailed" name="Not read" attachedToRef="ReadReply">
        <bpmn:outgoing>Flow_ReplyFailed_TransportError</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_ReplyFailed" errorRef="Error_SEND_FAILED" />
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Accepted" name="Receipt accepted?" default="Flow_Accepted_DeliveryHelp">
        <bpmn:incoming>Flow_Redirect_Accepted</bpmn:incoming>
        <bpmn:incoming>Flow_ReadReply_Accepted</bpmn:incoming>
        <bpmn:outgoing>Flow_Accepted_Receipt</bpmn:outgoing>
        <bpmn:outgoing>Flow_Accepted_SetServerFeedback</bpmn:outgoing>
        <bpmn:outgoing>Flow_Accepted_DeliveryHelp</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="SetServerFeedback" name="Show the structural/runtime feedback">
        <bpmn:extensionElements><zeebe:script expression="=receipt.feedback" resultVariable="fbCheck" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Accepted_SetServerFeedback</bpmn:incoming>
        <bpmn:incoming>Flow_Recheck_SetServerFeedback</bpmn:incoming>
        <bpmn:outgoing>Flow_SetServerFeedback_SendResultsEnd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="Receipt" name="S03 · Delivery receipt">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-receipt" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_Accepted_Receipt</bpmn:incoming>
        <bpmn:outgoing>Flow_Receipt_SendResultsEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:scriptTask id="TransportError" name="Record the delivery problem">
        <bpmn:extensionElements><zeebe:script expression='="No confirmed receipt. Restore internet and retry; your approved attempt is preserved."' resultVariable="deliveryError" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_SendFailed_TransportError</bpmn:incoming>
        <bpmn:incoming>Flow_ReplyFailed_TransportError</bpmn:incoming>
        <bpmn:outgoing>Flow_TransportError_DeliveryHelp</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:userTask id="DeliveryHelp" name="S03 · Delivery pending">
        <bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="class-s03-not-sent" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_CanSend_DeliveryHelp</bpmn:incoming>
        <bpmn:incoming>Flow_Accepted_DeliveryHelp</bpmn:incoming>
        <bpmn:incoming>Flow_TransportError_DeliveryHelp</bpmn:incoming>
        <bpmn:outgoing>Flow_DeliveryHelp_NextAction</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="NextAction" name="Retry or recheck?" default="Flow_NextAction_Pending">
        <bpmn:incoming>Flow_DeliveryHelp_NextAction</bpmn:incoming>
        <bpmn:outgoing>Flow_NextAction_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_NextAction_Recheck</bpmn:outgoing>
        <bpmn:outgoing>Flow_NextAction_Pending</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="Recheck" name="Request a new check">
        <bpmn:extensionElements><zeebe:script expression='={needsCorrection: true, feedback: "Review the guide, select the session version and check again."}' resultVariable="receipt" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NextAction_Recheck</bpmn:incoming>
        <bpmn:outgoing>Flow_Recheck_SetServerFeedback</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Pending" name="Keep delivery pending">
        <bpmn:extensionElements><zeebe:script expression="={ok: false, pending: true}" resultVariable="receipt" /></bpmn:extensionElements>
        <bpmn:incoming>Flow_NextAction_Pending</bpmn:incoming>
        <bpmn:outgoing>Flow_Pending_SendResultsEnd</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_SendResultsStart_CanSend" sourceRef="SendResultsStart" targetRef="CanSend" />
      <bpmn:sequenceFlow id="Flow_CanSend_Send" name="yes" sourceRef="CanSend" targetRef="Send">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cfg.resultsUrl != ""</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_CanSend_DeliveryHelp" name="no" sourceRef="CanSend" targetRef="DeliveryHelp" />
      <bpmn:sequenceFlow id="Flow_Send_Redirect" sourceRef="Send" targetRef="Redirect" />
      <bpmn:sequenceFlow id="Flow_Redirect_ReadReply" name="yes" sourceRef="Redirect" targetRef="ReadReply">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=replyUrl != null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Redirect_Accepted" name="no" sourceRef="Redirect" targetRef="Accepted" />
      <bpmn:sequenceFlow id="Flow_ReadReply_Accepted" sourceRef="ReadReply" targetRef="Accepted" />
      <bpmn:sequenceFlow id="Flow_Accepted_Receipt" name="yes" sourceRef="Accepted" targetRef="Receipt">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=receipt.ok = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Accepted_SetServerFeedback" name="correct work" sourceRef="Accepted" targetRef="SetServerFeedback">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=receipt.needsCorrection = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Accepted_DeliveryHelp" name="not confirmed" sourceRef="Accepted" targetRef="DeliveryHelp" />
      <bpmn:sequenceFlow id="Flow_SetServerFeedback_SendResultsEnd" sourceRef="SetServerFeedback" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_Receipt_SendResultsEnd" sourceRef="Receipt" targetRef="SendResultsEnd" />
      <bpmn:sequenceFlow id="Flow_SendFailed_TransportError" sourceRef="SendFailed" targetRef="TransportError" />
      <bpmn:sequenceFlow id="Flow_ReplyFailed_TransportError" sourceRef="ReplyFailed" targetRef="TransportError" />
      <bpmn:sequenceFlow id="Flow_TransportError_DeliveryHelp" sourceRef="TransportError" targetRef="DeliveryHelp" />
      <bpmn:sequenceFlow id="Flow_DeliveryHelp_NextAction" sourceRef="DeliveryHelp" targetRef="NextAction" />
      <bpmn:sequenceFlow id="Flow_NextAction_Send" name="retry" sourceRef="NextAction" targetRef="Send">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryAction = "retry"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_NextAction_Recheck" name="recheck" sourceRef="NextAction" targetRef="Recheck">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryAction = "recheck"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Recheck_SetServerFeedback" sourceRef="Recheck" targetRef="SetServerFeedback" />
      <bpmn:sequenceFlow id="Flow_NextAction_Pending" name="teacher told" sourceRef="NextAction" targetRef="Pending" />
      <bpmn:sequenceFlow id="Flow_Pending_SendResultsEnd" sourceRef="Pending" targetRef="SendResultsEnd" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Outcome" name="Work needs correction?" default="Flow_Outcome_End">
      <bpmn:incoming>Flow_SendResults_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_CheckWork</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Check closed">
      <bpmn:incoming>Flow_Outcome_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Config" sourceRef="Start" targetRef="Config" />
    <bpmn:sequenceFlow id="Flow_Config_CheckWork" sourceRef="Config" targetRef="CheckWork" />
    <bpmn:sequenceFlow id="Flow_CheckWork_Snapshot" sourceRef="CheckWork" targetRef="Snapshot" />
    <bpmn:sequenceFlow id="Flow_Snapshot_SendResults" sourceRef="Snapshot" targetRef="SendResults" />
    <bpmn:sequenceFlow id="Flow_SendResults_Outcome" sourceRef="SendResults" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_Outcome_CheckWork" name="correct and recheck" sourceRef="Outcome" targetRef="CheckWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=receipt.needsCorrection = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Outcome_End" name="closed" sourceRef="Outcome" targetRef="End" />
  </bpmn:process>
