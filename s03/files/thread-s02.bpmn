<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_student-request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="student-request" name="Student request" isExecutable="true">
    <bpmn:documentation>Running case of the 12-session course, version of session 02.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Request received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="request-intake" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_ComputeDue</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="ComputeDue" name="Compute due date">
      <bpmn:extensionElements>
        <zeebe:script expression="=string(today() + duration(&#34;P5D&#34;))" resultVariable="dueDate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_ComputeDue</bpmn:incoming>
      <bpmn:outgoing>Flow_ComputeDue_Review</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Review" name="Review request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ComputeDue_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Summary</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Summary" name="Build summary">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Request of &#34; + studentName + &#34; (&#34; + requestType + &#34;): &#34; + decision" resultVariable="summary" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Review_Summary</bpmn:incoming>
      <bpmn:outgoing>Flow_Summary_End</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="Request closed">
      <bpmn:incoming>Flow_Summary_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_ComputeDue" sourceRef="Start" targetRef="ComputeDue" />
    <bpmn:sequenceFlow id="Flow_ComputeDue_Review" sourceRef="ComputeDue" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_Summary" sourceRef="Review" targetRef="Summary" />
    <bpmn:sequenceFlow id="Flow_Summary_End" sourceRef="Summary" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_student_request">
    <bpmndi:BPMNPlane id="Plane_student_request" bpmnElement="student-request">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="177" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="152" y="163" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ComputeDue_di" bpmnElement="ComputeDue">
        <dc:Bounds x="310" y="105" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="480" y="105" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Summary_di" bpmnElement="Summary">
        <dc:Bounds x="650" y="105" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="857" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="837" y="163" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_ComputeDue_di" bpmnElement="Flow_Start_ComputeDue">
        <di:waypoint x="213" y="145" />
        <di:waypoint x="310" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ComputeDue_Review_di" bpmnElement="Flow_ComputeDue_Review">
        <di:waypoint x="420" y="145" />
        <di:waypoint x="480" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Review_Summary_di" bpmnElement="Flow_Review_Summary">
        <di:waypoint x="590" y="145" />
        <di:waypoint x="650" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Summary_End_di" bpmnElement="Flow_Summary_End">
        <di:waypoint x="760" y="145" />
        <di:waypoint x="857" y="145" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
